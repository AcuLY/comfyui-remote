# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Claude Code local settings
.claude/settings.local.json

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# local Manager/worker machine configs
config/*.local.json
config/*local.json
config/*.local.json.bak-*
config/training-dataset-angle-sections.*.json
scripts/training/sync-angle-sections.ts

# local Manager runtime data, build artifacts, and deploy/debug logs
/data/
/logs/
/metrics/
/.deploy.lock/
/.superpowers/
/.tmp/
/tmp/
/scripts/tmp/
/.next.pre-prod-switch-*/
/.next.failed-build-*/
/comfyui-manager-build-backups/
*.log
*.err.log
*.trace
*.heapprofile
*.heapsnapshot

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# python
**/__pycache__/
*.pyc

/src/generated/prisma
/src/generated/prisma-sqlite

# SQLite database files
*.db
*.db-journal
*.sqlite
