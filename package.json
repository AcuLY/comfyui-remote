{
  "name": "comfyui-manager",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "test": "node --import tsx --test \"tests/*.test.ts\" \"src/app/design-demos/**/*.test.ts\" \"src/app/design-demos/**/*.test.mjs\" \"src/components/design-demo-ui/**/*.test.ts\" \"src/components/design-demo-ui/**/*.test.mjs\"",
    "docs:check": "tsx scripts/docs/check.ts",
    "skills:check": "node scripts/skills/validate.mjs",
    "openspec:status": "openspec status",
    "openspec:instructions": "openspec instructions",
    "openspec:validate": "openspec validate --all --strict --no-interactive",
    "openspec:archive": "openspec archive",
    "prisma:generate": "DB_PROVIDER=postgresql prisma generate",
    "prisma:generate:sqlite": "DB_PROVIDER=sqlite prisma generate",
    "prisma:generate:all": "DB_PROVIDER=postgresql prisma generate && DB_PROVIDER=sqlite prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:db:push": "prisma db push",
    "prisma:seed": "node --experimental-strip-types prisma/seed.ts",
    "prisma:studio": "prisma studio",
    "db:seed": "npx tsx src/scripts/seed.mts",
    "db:bootstrap": "prisma migrate dev && npx tsx src/scripts/seed.mts",
    "db:bootstrap:sqlite": "DB_PROVIDER=sqlite prisma generate && DB_PROVIDER=sqlite DATABASE_URL=file:./data/comfyui.db prisma migrate dev && DB_PROVIDER=sqlite DATABASE_URL=file:./data/comfyui.db npx tsx src/scripts/seed.mts",
    "quality:baseline": "tsx scripts/quality/baseline.ts",
    "quality:evaluate": "tsx scripts/quality/evaluate.ts",
    "quality:review": "tsx scripts/quality/review.ts",
    "quality:verify": "tsx scripts/quality/verify.ts",
    "training:workers": "tsx scripts/training/worker-queue.ts",
    "training:workers:mock": "tsx scripts/training/worker-queue.ts --mock-image --dry-run-training --mock-complete-training"
  },
  "prisma": {
    "seed": "node --experimental-strip-types prisma/seed.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@prisma/adapter-better-sqlite3": "^7.5.0",
    "@prisma/adapter-pg": "^7.5.0",
    "@prisma/client": "^7.5.0",
    "@types/archiver": "^7.0.0",
    "archiver": "^7.0.1",
    "better-sqlite3": "^12.8.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.11.0",
    "next": "16.2.1",
    "pg": "^8.20.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.5.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@fission-ai/openspec": "1.5.0",
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/js-yaml": "4.0.9",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "ajv": "8.20.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "github-slugger": "2.0.0",
    "js-yaml": "4.1.1",
    "minimatch": "10.2.5",
    "prisma": "^7.5.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "unified": "11.0.5"
  }
}
