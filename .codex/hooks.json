{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 scripts/observability/agent_file_access_hook.py record --root .",
            "commandWindows": "python scripts/observability/agent_file_access_hook.py record --root .",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "node .impeccable/prototype-hook.mjs",
            "commandWindows": "node .impeccable/prototype-hook.mjs",
            "timeout": 5,
            "statusMessage": "Checking prototype design"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .impeccable/prototype-hook.mjs",
            "commandWindows": "node .impeccable/prototype-hook.mjs",
            "timeout": 30,
            "statusMessage": "Prototype design pass"
          }
        ]
      }
    ]
  }
}
