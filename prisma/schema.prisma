generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum JobStatus {
  draft
  queued
  running
  partial_done
  done
  failed
}

enum RunStatus {
  queued
  running
  done
  failed
  cancelled
  paused
}

enum ReviewStatus {
  pending
  kept
  trashed
}

enum ActorType {
  user
  system
  agent
}

enum CharacterLoraJobStatus {
  draft
  canonical_pending
  prompt_pending
  section_generating
  reviewing
  dataset_ready
  training_queued
  training_running
  trained
  benchmarking
  benchmark_review
  promotion_ready
  promoted
  failed
  cancelled
  archived
}

enum CharacterLoraImageReviewStatus {
  pending
  keep
  reject
  excluded
  included_in_training
}

enum CharacterLoraRunStatus {
  queued
  running
  done
  failed
  cancelled
}

enum CharacterLoraArtifactKind {
  source_image
  canonical_image
  candidate_image
  prompt
  provider_payload
  caption
  dataset_manifest
  training_config
  training_log
  safetensors
  benchmark_report
  promotion_report
}

enum CharacterLoraWorkerType {
  image_generation
  dataset_freeze
  training
  benchmark
  promotion
}

enum CharacterLoraDecisionStatus {
  draft
  approved
  rejected
  promoted
  superseded
}

// ── Preset system ──

model PresetCategory {
  id                  String          @id @default(cuid())
  name                String          // e.g. "角色", "场景", "风格", "镜位"
  slug                String          @unique
  icon                String?         // lucide icon name for UI badge
  color               String?         // HSL color string
  positivePromptOrder Int             @default(0)
  negativePromptOrder Int             @default(0)
  lora1Order          Int             @default(0)
  lora2Order          Int             @default(0)
  sortOrder           Int             @default(0)
  type                String          @default("preset") // "preset" | "group"
  slotTemplate        Json?           // type=group: [{ categoryId: string, label?: string }]
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  presets             Preset[]
  groups              PresetGroup[]
  folders             PresetFolder[]
}

model Preset {
  id              String          @id @default(cuid())
  categoryId      String
  name            String
  slug            String
  isActive        Boolean         @default(true)
  sortOrder       Int             @default(0)
  notes           String?         @db.Text
  civitaiLinks    Json?           // string[] — external Civitai model/version URLs
  folderId        String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  category        PresetCategory  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  folder          PresetFolder?   @relation(fields: [folderId], references: [id], onDelete: SetNull)
  variants        PresetVariant[]
  changeLogs      PresetChangeLog[]

  @@unique([categoryId, slug])
  @@index([categoryId, sortOrder])
}

model PresetVariant {
  id              String          @id @default(cuid())
  presetId        String
  name            String
  slug            String
  prompt          String          @db.Text  // positive prompt
  negativePrompt  String?         @db.Text
  lora1           Json?           // Array<LoraBinding> — stage 1
  lora2           Json?           // Array<LoraBinding> — stage 2 (upscale)
  linkedVariants  Json?           // [{ presetId: string, variantId: string }] — linked variant refs
  sortOrder       Int             @default(0)
  isActive        Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  preset          Preset          @relation(fields: [presetId], references: [id], onDelete: Cascade)

  @@unique([presetId, slug])
  @@index([presetId, sortOrder])
}

model PresetGroup {
  id          String               @id @default(cuid())
  categoryId  String
  name        String
  slug        String
  sortOrder   Int                  @default(0)
  isActive    Boolean              @default(true)
  folderId    String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  category    PresetCategory       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  folder      PresetFolder?        @relation(fields: [folderId], references: [id], onDelete: SetNull)
  members     PresetGroupMember[]
  changeLogs  PresetGroupChangeLog[]

  @@unique([categoryId, slug])
  @@index([categoryId, sortOrder])
}

model PresetChangeLog {
  id        String   @id @default(cuid())
  presetId  String
  dimension String   // "variants" | "content"
  title     String
  before    Json?
  after     Json?
  createdAt DateTime @default(now())
  preset    Preset   @relation(fields: [presetId], references: [id], onDelete: Cascade)

  @@index([presetId, dimension, createdAt])
}

model PresetGroupChangeLog {
  id            String      @id @default(cuid())
  presetGroupId String
  dimension     String      // "meta" | "members"
  title         String
  before        Json?
  after         Json?
  createdAt     DateTime    @default(now())
  presetGroup   PresetGroup @relation(fields: [presetGroupId], references: [id], onDelete: Cascade)

  @@index([presetGroupId, dimension, createdAt])
}

model PresetGroupMember {
  id              String      @id @default(cuid())
  groupId         String
  presetId        String?     // reference a preset (+ optional variantId)
  variantId       String?     // specific variant of the preset
  subGroupId      String?     // or reference another group (mutually exclusive with presetId)
  slotCategoryId  String?     // if from slot template, locks to this category
  sortOrder       Int         @default(0)
  group           PresetGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId, sortOrder])
}

model PresetFolder {
  id          String         @id @default(cuid())
  categoryId  String
  parentId    String?
  name        String
  sortOrder   Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  category    PresetCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  parent      PresetFolder?  @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children    PresetFolder[] @relation("FolderTree")
  presets     Preset[]
  groups      PresetGroup[]

  @@index([categoryId, parentId, sortOrder])
}

// ── Project Templates ──

model ProjectTemplate {
  id             String                  @id @default(cuid())
  name           String
  description    String?                 @db.Text
  presetBindings Json?                    // [{ categoryId, presetId, variantId? }] — project-level preset bindings
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  sections       ProjectTemplateSection[]
  sectionFolders ProjectTemplateSectionFolder[]

  @@index([createdAt])
}

model ProjectTemplateSection {
  id                String            @id @default(cuid())
  projectTemplateId String
  folderId          String?
  sortOrder         Int               @default(0)
  name              String?
  notes             String?           @db.Text
  aspectRatio       String?
  shortSidePx       Int?
  batchSize         Int?
  seedPolicy1       String?
  seedPolicy2       String?
  ksampler1         Json?             // KSamplerParams for KSampler1
  ksampler2         Json?             // KSamplerParams for KSampler2
  upscaleFactor     Float?
  checkpointName    String?
  loraConfig        Json?             // { lora1: LoraEntry[], lora2: LoraEntry[] }
  extraParams       Json?
  promptBlocks      Json?             // Array<{ label, positive, negative?, sortOrder }>
  projectTemplate    ProjectTemplate  @relation(fields: [projectTemplateId], references: [id], onDelete: Cascade)
  folder             ProjectTemplateSectionFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  @@index([projectTemplateId, sortOrder])
  @@index([folderId])
}

model ProjectTemplateSectionFolder {
  id                String                         @id @default(cuid())
  projectTemplateId String
  parentId          String?
  name              String
  sortOrder         Int                            @default(0)
  createdAt         DateTime                       @default(now())
  updatedAt         DateTime                       @updatedAt
  projectTemplate   ProjectTemplate                @relation(fields: [projectTemplateId], references: [id], onDelete: Cascade)
  parent            ProjectTemplateSectionFolder?  @relation("ProjectTemplateSectionFolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children          ProjectTemplateSectionFolder[] @relation("ProjectTemplateSectionFolderTree")
  sections          ProjectTemplateSection[]

  @@index([projectTemplateId, parentId, sortOrder])
}

// ── Core models ──

enum PromptBlockType {
  custom
  preset
}

model Project {
  id                    String                @id @default(cuid())
  title                 String
  slug                  String                @unique
  status                JobStatus             @default(draft)
  coverImageId          String?
  folderId              String?
  presetBindings        Json?                 // [{ categoryId, presetId, variantId? }]
  checkpointName        String?
  projectLevelOverrides Json?
  notes                 String?               @db.Text
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  folder                ProjectFolder?        @relation(fields: [folderId], references: [id], onDelete: SetNull)
  sections              ProjectSection[]
  sectionFolders        ProjectSectionFolder[]
  runs                  Run[]
  @@index([status, updatedAt])
  @@index([coverImageId])
  @@index([folderId])
}

model ProjectFolder {
  id          String          @id @default(cuid())
  parentId    String?
  name        String
  sortOrder   Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  parent      ProjectFolder?  @relation("ProjectFolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children    ProjectFolder[] @relation("ProjectFolderTree")
  projects    Project[]

  @@index([parentId, sortOrder])
}

model ProjectSection {
  id                    String                @id @default(cuid())
  projectId             String
  folderId              String?
  name                  String?
  sortOrder             Int                   @default(0)
  enabled               Boolean               @default(true)
  positivePrompt        String?               @db.Text
  negativePrompt        String?               @db.Text
  aspectRatio           String?
  shortSidePx           Int?
  batchSize             Int?
  seedPolicy1           String?
  seedPolicy2           String?
  ksampler1             Json?                 // KSamplerParams for KSampler1
  ksampler2             Json?                 // KSamplerParams for KSampler2
  upscaleFactor         Float?                // 放大倍数：1/1.5/2/2.5/3，默认 2
  checkpointName        String?
  loraConfig            Json?                 // { lora1: LoraEntry[], lora2: LoraEntry[] }
  extraParams           Json?
  latestRunId           String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  project               Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  folder                ProjectSectionFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  runs                  Run[]
  promptBlocks          PromptBlock[]
  changeLogs            SectionChangeLog[]

  @@index([projectId, sortOrder])
  @@index([folderId])
}

model ProjectSectionFolder {
  id          String                 @id @default(cuid())
  projectId   String
  parentId    String?
  name        String
  sortOrder   Int                    @default(0)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  project     Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent      ProjectSectionFolder?  @relation("ProjectSectionFolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children    ProjectSectionFolder[] @relation("ProjectSectionFolderTree")
  sections    ProjectSection[]

  @@index([projectId, parentId, sortOrder])
}

model SectionChangeLog {
  id                    String                @id @default(cuid())
  projectSectionId      String
  dimension             String                // "runParams" | "prompt" | "lora"
  title                 String
  before                Json?
  after                 Json?
  createdAt             DateTime              @default(now())
  projectSection        ProjectSection        @relation(fields: [projectSectionId], references: [id], onDelete: Cascade)

  @@index([projectSectionId, dimension, createdAt])
}

model PromptBlock {
  id                    String                @id @default(cuid())
  projectSectionId      String
  type                  PromptBlockType
  sourceId              String?               // FK to Preset (when type="preset")
  variantId             String?               // FK to PresetVariant (current variant)
  categoryId            String?               // FK to PresetCategory
  bindingId             String?               // groups blocks+loras from same preset import
  groupBindingId        String?               // groups all bindings from same group import
  label                 String
  positive              String                @db.Text
  negative              String?               @db.Text
  sortOrder             Int                   @default(0)
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  projectSection        ProjectSection        @relation(fields: [projectSectionId], references: [id], onDelete: Cascade)

  @@index([projectSectionId, sortOrder])
}

model Run {
  id                    String                @id @default(cuid())
  projectId             String
  projectSectionId      String
  runIndex              Int                   @default(1)
  status                RunStatus             @default(queued)
  resolvedConfigSnapshot Json
  comfyPromptId         String?
  executionMeta         Json?                 // { ks1Seed, ks2Seed, ks1Steps, ks1Cfg, ... }
  submittedPrompt       Json?                 // Full submitted ComfyUI workflow JSON
  outputDir             String?
  errorMessage          String?               @db.Text
  startedAt             DateTime?
  finishedAt            DateTime?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  project               Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectSection        ProjectSection        @relation(fields: [projectSectionId], references: [id], onDelete: Cascade)
  images                ImageResult[]

  @@index([status, createdAt])
  @@index([projectId, createdAt])
  @@index([projectSectionId, createdAt])
}

model ImageResult {
  id                    String          @id @default(cuid())
  runId                 String
  filePath              String          @unique
  thumbPath             String?
  width                 Int?
  height                Int?
  fileSize              BigInt?
  reviewStatus          ReviewStatus    @default(pending)
  featured              Boolean         @default(false)
  featured2             Boolean         @default(false)
  reviewedAt            DateTime?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  run                   Run             @relation(fields: [runId], references: [id], onDelete: Cascade)
  trashRecord           TrashRecord?

  @@index([reviewStatus, createdAt])
  @@index([runId, createdAt])
}

model TrashRecord {
  id                    String       @id @default(cuid())
  imageResultId         String       @unique
  originalPath          String
  trashPath             String
  reason                String?
  deletedAt             DateTime     @default(now())
  restoredAt            DateTime?
  actorType             ActorType    @default(user)
  imageResult           ImageResult  @relation(fields: [imageResultId], references: [id], onDelete: Cascade)

  @@index([deletedAt])
  @@index([restoredAt])
}

model LoraAsset {
  id                    String      @id @default(cuid())
  name                  String
  modelType             String      @default("lora")
  category              String
  fileName              String
  absolutePath          String      @unique
  relativePath          String
  size                  BigInt?
  source                String?
  notes                 String?     @db.Text
  triggerWords          String?     @db.Text  // trigger words for this LoRA
  uploadedAt            DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
}

model AuditLog {
  id                    String      @id @default(cuid())
  entityType            String
  entityId              String
  action                String
  payload               Json?
  actorType             ActorType   @default(system)
  createdAt             DateTime    @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([action, createdAt])
}

// Character LoRA training

model CharacterLoraTrainingJob {
  id                         String                         @id @default(cuid())
  slug                       String                         @unique
  characterName              String
  triggerToken               String
  status                     CharacterLoraJobStatus         @default(draft)
  phase                      String?
  trainingScope              Json
  captionStrategy            String                         @default("controllable_identity")
  baseCheckpointName         String?
  baseCheckpointPath         String?
  baseCheckpointHash         String?
  baseFamily                 String?
  artifactRoot               String
  currentCanonicalVersionId  String?
  currentPromptCardVersionId String?
  selectedDatasetRevisionId  String?
  promotedPresetId           String?
  createdBy                  String?
  failureSummary             String?                        @db.Text
  createdAt                  DateTime                       @default(now())
  updatedAt                  DateTime                       @updatedAt
  sourceImages               CharacterLoraSourceImage[]
  canonicalVersions          CharacterLoraCanonicalVersion[]
  promptCardVersions         CharacterLoraPromptCardVersion[]
  sections                   CharacterLoraJobSection[]
  generationRuns             CharacterLoraGenerationRun[]
  candidateImages            CharacterLoraCandidateImage[]
  datasetRevisions           CharacterLoraDatasetRevision[]
  trainingRuns               CharacterLoraTrainingRun[]
  benchmarkRuns              CharacterLoraBenchmarkRun[]
  promotionDecisions         CharacterLoraPromotionDecision[]
  artifacts                  CharacterLoraArtifact[]
  workerTasks                CharacterLoraWorkerTask[]

  @@index([status, updatedAt])
  @@index([triggerToken])
  @@index([baseCheckpointHash])
}

model CharacterLoraSourceImage {
  id         String                   @id @default(cuid())
  jobId      String
  role       String
  artifactId String
  filePath   String
  sha256     String
  width      Int?
  height     Int?
  provenance Json?
  sortOrder  Int                      @default(0)
  createdAt  DateTime                 @default(now())
  job        CharacterLoraTrainingJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, sha256, role])
  @@index([jobId, sortOrder])
}

model CharacterLoraCanonicalVersion {
  id                String                       @id @default(cuid())
  jobId             String
  version           Int
  status            String                       @default("candidate")
  sourceRunId       String?
  imageArtifactId   String
  selectedAt        DateTime?
  notes             String?                      @db.Text
  createdAt         DateTime                     @default(now())
  job               CharacterLoraTrainingJob     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  sourceRun         CharacterLoraGenerationRun?  @relation(fields: [sourceRunId], references: [id], onDelete: SetNull)
  promptCards       CharacterLoraPromptCardVersion[]
  sections          CharacterLoraJobSection[]
  datasetRevisions  CharacterLoraDatasetRevision[]

  @@unique([jobId, version])
  @@index([jobId, status])
  @@index([sourceRunId])
}

model CharacterLoraPromptCardVersion {
  id                 String                         @id @default(cuid())
  jobId              String
  canonicalVersionId String?
  version            Int
  triggerToken       String
  identityTraits     Json
  outfitTraits       Json
  negativeTraits     Json?
  finalPromptDraft   String                         @db.Text
  changeReason       String?                        @db.Text
  createdAt          DateTime                       @default(now())
  job                CharacterLoraTrainingJob       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  canonicalVersion   CharacterLoraCanonicalVersion? @relation(fields: [canonicalVersionId], references: [id], onDelete: SetNull)
  sections           CharacterLoraJobSection[]
  datasetRevisions   CharacterLoraDatasetRevision[]

  @@unique([jobId, version])
  @@index([canonicalVersionId])
}

model CharacterLoraSectionTemplate {
  id                   String                    @id @default(cuid())
  key                  String                    @unique
  name                 String
  description          String?                   @db.Text
  angleTag             String?
  promptTemplate       String                    @db.Text
  negativeTemplate     String?                   @db.Text
  targetCandidateCount Int                       @default(4)
  targetKeepCount      Int                       @default(1)
  sortOrder            Int                       @default(0)
  isActive             Boolean                   @default(true)
  sections             CharacterLoraJobSection[]

  @@index([isActive, sortOrder])
}

model CharacterLoraJobSection {
  id                   String                          @id @default(cuid())
  jobId                String
  templateId           String?
  key                  String
  name                 String
  canonicalVersionId   String
  promptCardVersionId  String
  targetCandidateCount Int                             @default(4)
  targetKeepCount      Int                             @default(1)
  status               String                          @default("draft")
  keepCount            Int                             @default(0)
  rejectCount          Int                             @default(0)
  pendingCount         Int                             @default(0)
  sortOrder            Int                             @default(0)
  createdAt            DateTime                        @default(now())
  updatedAt            DateTime                        @updatedAt
  job                  CharacterLoraTrainingJob        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  template             CharacterLoraSectionTemplate?   @relation(fields: [templateId], references: [id], onDelete: SetNull)
  canonicalVersion     CharacterLoraCanonicalVersion   @relation(fields: [canonicalVersionId], references: [id], onDelete: Restrict)
  promptCardVersion    CharacterLoraPromptCardVersion  @relation(fields: [promptCardVersionId], references: [id], onDelete: Restrict)
  generationRuns       CharacterLoraGenerationRun[]
  candidateImages      CharacterLoraCandidateImage[]

  @@unique([jobId, key])
  @@index([jobId, sortOrder])
  @@index([templateId])
}

model CharacterLoraGenerationRun {
  id                String                       @id @default(cuid())
  jobId             String
  sectionId         String?
  kind              String
  parentRunId       String?
  status            CharacterLoraRunStatus       @default(queued)
  provider          String
  hostModel         String?
  imageModel        String
  hostInstruction   String                       @db.Text
  visualPrompt      String                       @db.Text
  negativePrompt    String?                      @db.Text
  toolParams        Json
  inputImages       Json
  requestArtifactId String?
  responseSummary   Json?
  errorSummary      String?                      @db.Text
  startedAt         DateTime?
  finishedAt        DateTime?
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt
  job               CharacterLoraTrainingJob     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  section           CharacterLoraJobSection?     @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  parentRun         CharacterLoraGenerationRun?  @relation("CharacterLoraGenerationRunTree", fields: [parentRunId], references: [id], onDelete: SetNull)
  childRuns         CharacterLoraGenerationRun[] @relation("CharacterLoraGenerationRunTree")
  canonicalVersions CharacterLoraCanonicalVersion[]
  candidateImages   CharacterLoraCandidateImage[]

  @@index([jobId, status])
  @@index([sectionId, createdAt])
  @@index([parentRunId])
}

model CharacterLoraCandidateImage {
  id                        String                           @id @default(cuid())
  jobId                     String
  sectionId                 String?
  generationRunId           String
  artifactId                String
  filePath                  String                           @unique
  sha256                    String
  width                     Int?
  height                    Int?
  fileSize                  BigInt?
  reviewStatus              CharacterLoraImageReviewStatus   @default(pending)
  rejectReasons             Json?
  reviewNote                String?                          @db.Text
  captionDraft              String?                          @db.Text
  reviewedAt                DateTime?
  includedDatasetRevisionId String?
  createdAt                 DateTime                         @default(now())
  updatedAt                 DateTime                         @updatedAt
  job                       CharacterLoraTrainingJob         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  section                   CharacterLoraJobSection?         @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  generationRun             CharacterLoraGenerationRun       @relation(fields: [generationRunId], references: [id], onDelete: Cascade)
  includedDatasetRevision   CharacterLoraDatasetRevision?    @relation("CharacterLoraIncludedDatasetRevision", fields: [includedDatasetRevisionId], references: [id], onDelete: SetNull)
  datasetItems              CharacterLoraDatasetItem[]

  @@index([jobId, reviewStatus])
  @@index([sectionId, reviewStatus])
  @@index([generationRunId])
  @@index([includedDatasetRevisionId])
}

model CharacterLoraDatasetRevision {
  id                         String                           @id @default(cuid())
  jobId                      String
  version                    Int
  status                     String                           @default("freezing")
  canonicalVersionId         String
  promptCardVersionId        String
  captionStrategy            String                           @default("controllable_identity")
  itemCount                  Int                              @default(0)
  sourceCount                Int                              @default(0)
  syntheticCount             Int                              @default(0)
  selectedManifestArtifactId String
  metadataJsonlArtifactId    String
  captionAuditArtifactId     String?
  trainDir                   String
  frozenAt                   DateTime?
  createdAt                  DateTime                         @default(now())
  updatedAt                  DateTime                         @updatedAt
  job                        CharacterLoraTrainingJob         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  canonicalVersion           CharacterLoraCanonicalVersion    @relation(fields: [canonicalVersionId], references: [id], onDelete: Restrict)
  promptCardVersion          CharacterLoraPromptCardVersion   @relation(fields: [promptCardVersionId], references: [id], onDelete: Restrict)
  includedCandidateImages    CharacterLoraCandidateImage[]    @relation("CharacterLoraIncludedDatasetRevision")
  items                      CharacterLoraDatasetItem[]
  trainingRuns               CharacterLoraTrainingRun[]

  @@unique([jobId, version])
  @@index([jobId, status])
  @@index([canonicalVersionId])
  @@index([promptCardVersionId])
}

model CharacterLoraDatasetItem {
  id                String                         @id @default(cuid())
  datasetRevisionId String
  candidateImageId  String
  imageArtifactId   String
  captionArtifactId String
  captionText       String                         @db.Text
  repeatCount       Int                            @default(1)
  sourceWeight      Float?
  sortOrder         Int                            @default(0)
  datasetRevision   CharacterLoraDatasetRevision   @relation(fields: [datasetRevisionId], references: [id], onDelete: Cascade)
  candidateImage    CharacterLoraCandidateImage    @relation(fields: [candidateImageId], references: [id], onDelete: Restrict)

  @@unique([datasetRevisionId, candidateImageId])
  @@index([datasetRevisionId, sortOrder])
  @@index([candidateImageId])
}

model CharacterLoraTrainingRun {
  id                         String                         @id @default(cuid())
  jobId                      String
  datasetRevisionId          String
  status                     CharacterLoraRunStatus         @default(queued)
  launcher                   String
  resolvedConfig             Json
  configArtifactId           String
  dryRunSummaryArtifactId    String?
  logArtifactId              String?
  outputDir                  String?
  finalSafetensorsArtifactId String?
  finalSha256                String?
  metadataSummary            Json?
  currentStep                Int?
  targetSteps                Int?
  lossSnapshot               Json?
  cancelRequestedAt          DateTime?
  startedAt                  DateTime?
  finishedAt                 DateTime?
  createdAt                  DateTime                       @default(now())
  updatedAt                  DateTime                       @updatedAt
  job                        CharacterLoraTrainingJob       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  datasetRevision            CharacterLoraDatasetRevision   @relation(fields: [datasetRevisionId], references: [id], onDelete: Restrict)
  checkpoints                CharacterLoraTrainingCheckpoint[]
  benchmarkRuns              CharacterLoraBenchmarkRun[]

  @@index([jobId, status])
  @@index([datasetRevisionId])
  @@index([finalSha256])
}

model CharacterLoraTrainingCheckpoint {
  id            String                    @id @default(cuid())
  trainingRunId String
  step          Int
  artifactId    String
  sha256        String
  metrics       Json?
  createdAt     DateTime                  @default(now())
  trainingRun   CharacterLoraTrainingRun  @relation(fields: [trainingRunId], references: [id], onDelete: Cascade)

  @@unique([trainingRunId, step])
  @@index([trainingRunId, step])
  @@index([sha256])
}

model CharacterLoraBenchmarkRun {
  id                String                           @id @default(cuid())
  jobId             String
  trainingRunId     String
  status            CharacterLoraRunStatus           @default(queued)
  loraAssetId       String?
  testPresetId      String?
  testProjectId     String?
  templateId        String?
  checkpointMatrix  Json
  weightMatrix      Json
  reportArtifactId  String?
  recommendedWeight Float?
  resultSummary     Json?
  startedAt         DateTime?
  finishedAt        DateTime?
  createdAt         DateTime                         @default(now())
  updatedAt         DateTime                         @updatedAt
  job               CharacterLoraTrainingJob         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  trainingRun       CharacterLoraTrainingRun         @relation(fields: [trainingRunId], references: [id], onDelete: Restrict)
  promotionDecisions CharacterLoraPromotionDecision[]

  @@index([jobId, status])
  @@index([trainingRunId])
  @@index([testProjectId])
}

model CharacterLoraPromotionDecision {
  id                        String                         @id @default(cuid())
  jobId                     String
  benchmarkRunId            String
  status                    CharacterLoraDecisionStatus    @default(draft)
  selectedLoraAssetId       String
  selectedCheckpoint        String?
  defaultRecommendedWeight  Float
  perVariantWeightOverrides Json?
  variantPromptDrafts       Json
  decisionReason            String?                        @db.Text
  promotedCategoryId        String?
  promotedPresetId          String?
  reportArtifactId          String?
  decidedAt                 DateTime?
  promotedAt                DateTime?
  createdAt                 DateTime                       @default(now())
  updatedAt                 DateTime                       @updatedAt
  job                       CharacterLoraTrainingJob       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  benchmarkRun              CharacterLoraBenchmarkRun      @relation(fields: [benchmarkRunId], references: [id], onDelete: Restrict)

  @@index([jobId, status])
  @@index([benchmarkRunId])
  @@index([selectedLoraAssetId])
}

model CharacterLoraArtifact {
  id             String                    @id @default(cuid())
  jobId          String
  kind           CharacterLoraArtifactKind
  relativePath   String
  absolutePath   String?
  sha256         String?
  byteSize       BigInt?
  mimeType       String?
  redactionLevel String                    @default("path_only")
  metadata       Json?
  createdAt      DateTime                  @default(now())
  job            CharacterLoraTrainingJob  @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, relativePath])
  @@index([jobId, kind])
  @@index([sha256])
}

model CharacterLoraWorkerTask {
  id             String                   @id @default(cuid())
  jobId          String
  workerType     CharacterLoraWorkerType
  targetType     String
  targetId       String
  status         CharacterLoraRunStatus   @default(queued)
  payload        Json
  leaseOwner     String?
  leaseExpiresAt DateTime?
  attemptCount   Int                      @default(0)
  progressJson   Json?
  startedAt      DateTime?
  heartbeatAt    DateTime?
  finishedAt     DateTime?
  errorSummary   String?                  @db.Text
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  job            CharacterLoraTrainingJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([status, leaseExpiresAt])
  @@index([jobId, workerType, status])
  @@index([targetType, targetId])
}

model GpuTaskLock {
  id         String    @id @default(cuid())
  taskType   String
  ownerType  String
  ownerId    String
  status     String    @default("active")
  startedAt  DateTime  @default(now())
  releasedAt DateTime?
  metadata   Json?

  @@index([status, startedAt])
  @@index([ownerType, ownerId])
  @@index([taskType, status])
}
