generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma-sqlite"
}

datasource db {
  provider = "sqlite"
}

// Note: SQLite does not enforce enum values at the database level.
// Prisma handles validation at the application layer.

// ── Preset system ──

model PresetCategory {
  id                  String          @id @default(cuid())
  name                String          // e.g. "角色", "场景", "风格", "镜位"
  slug                String          @unique
  icon                String?         // lucide icon name for UI badge
  color               String?         // HSL color string
  positivePromptOrder Int             @default(0)
  negativePromptOrder Int             @default(0)
  lora1Order          Int             @default(0)
  lora2Order          Int             @default(0)
  sortOrder           Int             @default(0)
  type                String          @default("preset") // "preset" | "group"
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  presets             Preset[]
  groups              PresetGroup[]
  folders             PresetFolder[]
  ownedSlots          PresetCategorySlot[] @relation("PresetCategorySlotOwner")
  usedInSlots         PresetCategorySlot[] @relation("PresetCategorySlotTarget")
  projectBindings     ProjectPresetBinding[]
  templateBindings    ProjectTemplatePresetBinding[]
  sectionBindings     SectionPresetBinding[]
  templateSectionBindings     TemplateSectionPresetBinding[]
}

model Preset {
  id              String          @id @default(cuid())
  categoryId      String
  name            String
  slug            String
  isActive        Boolean         @default(true)
  sortOrder       Int             @default(0)
  notes           String?
  civitaiLinks    Json?           // string[] — external Civitai model/version URLs
  folderId        String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  category        PresetCategory  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  folder          PresetFolder?   @relation(fields: [folderId], references: [id], onDelete: SetNull)
  variants        PresetVariant[]
  changeLogs      PresetChangeLog[]
  projectBindings  ProjectPresetBinding[]
  templateBindings ProjectTemplatePresetBinding[]
  sectionBindings  SectionPresetBinding[]
  templateSectionBindings     TemplateSectionPresetBinding[]

  @@unique([categoryId, slug])
  @@unique([categoryId, id])
  @@index([categoryId, sortOrder])
}

model PresetVariant {
  id              String          @id @default(cuid())
  presetId        String
  name            String
  slug            String
  prompt          String          // positive prompt
  negativePrompt  String?
  lora1           Json?           // Array<LoraBinding> — stage 1
  lora2           Json?           // Array<LoraBinding> — stage 2 (upscale)
  sortOrder       Int             @default(0)
  isActive        Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  preset          Preset          @relation(fields: [presetId], references: [id], onDelete: Cascade)
  outgoingLinks   PresetVariantLink[] @relation("PresetVariantLinkSource")
  incomingLinks   PresetVariantLink[] @relation("PresetVariantLinkTarget")
  projectBindings ProjectPresetBinding[]
  templateBindings ProjectTemplatePresetBinding[]
  sectionBindings SectionPresetBinding[]
  templateSectionBindings     TemplateSectionPresetBinding[]

  @@unique([presetId, slug])
  @@unique([presetId, id])
  @@index([presetId, sortOrder])
}

model PresetVariantLink {
  id              String        @id @default(cuid())
  sourceVariantId String
  linkedVariantId String
  sortOrder       Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  sourceVariant   PresetVariant @relation("PresetVariantLinkSource", fields: [sourceVariantId], references: [id], onDelete: Cascade)
  linkedVariant   PresetVariant @relation("PresetVariantLinkTarget", fields: [linkedVariantId], references: [id], onDelete: Cascade)

  @@unique([sourceVariantId, linkedVariantId])
  @@index([sourceVariantId, sortOrder])
  @@index([linkedVariantId])
}

model PresetGroup {
  id          String               @id @default(cuid())
  categoryId  String
  name        String
  slug        String
  sortOrder   Int                  @default(0)
  isActive    Boolean              @default(true)
  folderId    String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  category    PresetCategory       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  folder      PresetFolder?        @relation(fields: [folderId], references: [id], onDelete: SetNull)
  members     PresetGroupMember[]
  changeLogs  PresetGroupChangeLog[]
  sectionBindings SectionPresetBinding[]
  templateSectionBindings TemplateSectionPresetBinding[]

  @@unique([categoryId, slug])
  @@index([categoryId, sortOrder])
}

model PresetChangeLog {
  id        String   @id @default(cuid())
  presetId  String
  dimension String   // "variants" | "content"
  title     String
  before    Json?
  after     Json?
  createdAt DateTime @default(now())
  preset    Preset   @relation(fields: [presetId], references: [id], onDelete: Cascade)

  @@index([presetId, dimension, createdAt])
}

model PresetGroupChangeLog {
  id            String      @id @default(cuid())
  presetGroupId String
  dimension     String      // "meta" | "members"
  title         String
  before        Json?
  after         Json?
  createdAt     DateTime    @default(now())
  presetGroup   PresetGroup @relation(fields: [presetGroupId], references: [id], onDelete: Cascade)

  @@index([presetGroupId, dimension, createdAt])
}

model PresetGroupMember {
  id              String      @id @default(cuid())
  groupId         String
  presetId        String?     // reference a preset (+ optional variantId)
  variantId       String?     // specific variant of the preset
  subGroupId      String?     // or reference another group (mutually exclusive with presetId)
  slotCategoryId  String?     // if from slot template, locks to this category
  sortOrder       Int         @default(0)
  group           PresetGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId, sortOrder])
}

model PresetCategorySlot {
  id             String         @id @default(cuid())
  categoryId     String
  slotKey        String
  slotCategoryId String
  label          String?
  sortOrder      Int            @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  category       PresetCategory @relation("PresetCategorySlotOwner", fields: [categoryId], references: [id], onDelete: Cascade)
  slotCategory   PresetCategory @relation("PresetCategorySlotTarget", fields: [slotCategoryId], references: [id], onDelete: Restrict)

  @@unique([categoryId, slotKey])
  @@index([categoryId, sortOrder])
  @@index([slotCategoryId])
}

model PresetFolder {
  id          String         @id @default(cuid())
  categoryId  String
  parentId    String?
  name        String
  sortOrder   Int            @default(0)
  category    PresetCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  parent      PresetFolder?  @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children    PresetFolder[] @relation("FolderTree")
  presets     Preset[]
  groups      PresetGroup[]

  @@index([categoryId, parentId, sortOrder])
}

// ── Project Templates ──

model ProjectTemplate {
  id             String                  @id @default(cuid())
  name           String
  description    String?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  sections       ProjectTemplateSection[]
  sectionFolders ProjectTemplateSectionFolder[]
  presetBindingRows ProjectTemplatePresetBinding[]

  @@index([createdAt])
}

model ProjectTemplatePresetBinding {
  id                String          @id @default(cuid())
  projectTemplateId String
  categoryId        String
  presetId          String
  variantId         String?
  sortOrder         Int             @default(0)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  projectTemplate   ProjectTemplate @relation(fields: [projectTemplateId], references: [id], onDelete: Cascade)
  category          PresetCategory  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  preset            Preset          @relation(fields: [categoryId, presetId], references: [categoryId, id], onDelete: Restrict)
  variant           PresetVariant?  @relation(fields: [presetId, variantId], references: [presetId, id], onDelete: Restrict)

  @@unique([projectTemplateId, categoryId])
  @@index([projectTemplateId, sortOrder])
  @@index([categoryId])
  @@index([presetId])
  @@index([variantId])
}

model ProjectTemplateSection {
  id                String            @id @default(cuid())
  projectTemplateId String
  folderId          String?
  sortOrder         Int               @default(0)
  name              String?
  notes             String?
  aspectRatio       String?
  aspectRatios      Json?
  shortSidePx       Int?
  batchSize         Int?
  seedPolicy1       String?
  seedPolicy2       String?
  ksampler1         Json?
  ksampler2         Json?
  upscaleFactor     Float?
  checkpointName    String?
  extraParams       Json?
  projectTemplate    ProjectTemplate  @relation(fields: [projectTemplateId], references: [id], onDelete: Cascade)
  folder             ProjectTemplateSectionFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  presetBindingRows  TemplateSectionPresetBinding[]
  promptBlockRows    TemplateSectionPromptBlock[]
  manualLoraEntries  TemplateSectionManualLoraEntry[]

  @@index([projectTemplateId, sortOrder])
  @@index([folderId])
}

model TemplateSectionPresetBinding {
  id                       String                 @id @default(cuid())
  projectTemplateSectionId String
  bindingKey               String
  categoryId               String
  presetId                 String?
  variantId                String?
  presetGroupId            String?
  groupBindingKey          String?
  sortOrder                Int                    @default(0)
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt
  projectTemplateSection   ProjectTemplateSection @relation(fields: [projectTemplateSectionId], references: [id], onDelete: Cascade)
  category                 PresetCategory         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  preset                   Preset?                @relation(fields: [categoryId, presetId], references: [categoryId, id], onDelete: Restrict)
  variant                  PresetVariant?         @relation(fields: [presetId, variantId], references: [presetId, id], onDelete: Restrict)
  presetGroup              PresetGroup?           @relation(fields: [presetGroupId], references: [id], onDelete: Restrict)
  promptBlock              TemplateSectionPromptBlock?
  manualLoraEntries        TemplateSectionManualLoraEntry[]

  @@unique([projectTemplateSectionId, bindingKey])
  @@unique([projectTemplateSectionId, id])
  @@index([projectTemplateSectionId, sortOrder])
  @@index([categoryId])
  @@index([presetId])
  @@index([variantId])
  @@index([presetGroupId])
  @@index([groupBindingKey])
}

model TemplateSectionPromptBlock {
  id                       String                        @id @default(cuid())
  projectTemplateSectionId String
  templateSectionBindingId String?                       @unique
  type                     String                        @default("custom")
  customLabel              String?
  customPositive           String?
  customNegative           String?
  sortOrder                Int                           @default(0)
  createdAt                DateTime                      @default(now())
  updatedAt                DateTime                      @updatedAt
  projectTemplateSection   ProjectTemplateSection        @relation(fields: [projectTemplateSectionId], references: [id], onDelete: Cascade)
  templateSectionBinding   TemplateSectionPresetBinding? @relation(fields: [projectTemplateSectionId, templateSectionBindingId], references: [projectTemplateSectionId, id], onDelete: Cascade)

  @@index([projectTemplateSectionId, sortOrder])
  @@unique([projectTemplateSectionId, templateSectionBindingId])
}

model TemplateSectionManualLoraEntry {
  id                       String                        @id @default(cuid())
  projectTemplateSectionId String
  templateSectionBindingId String?
  stage                    String
  path                     String
  weight                   Float                         @default(1)
  enabled                  Boolean                       @default(true)
  detachedFromBindingKey   String?
  detachedFromPresetId     String?
  detachedFromVariantId    String?
  detachedFromPath         String?
  metadata                 Json?
  sortOrder                Int                           @default(0)
  createdAt                DateTime                      @default(now())
  updatedAt                DateTime                      @updatedAt
  projectTemplateSection   ProjectTemplateSection        @relation(fields: [projectTemplateSectionId], references: [id], onDelete: Cascade)
  templateSectionBinding   TemplateSectionPresetBinding? @relation(fields: [projectTemplateSectionId, templateSectionBindingId], references: [projectTemplateSectionId, id], onDelete: Restrict)

  @@index([projectTemplateSectionId, stage, sortOrder])
  @@index([templateSectionBindingId])
  @@index([detachedFromBindingKey])
}

model ProjectTemplateSectionFolder {
  id                String                         @id @default(cuid())
  projectTemplateId String
  parentId          String?
  name              String
  sortOrder         Int                            @default(0)
  createdAt         DateTime                       @default(now())
  updatedAt         DateTime                       @updatedAt
  projectTemplate   ProjectTemplate                @relation(fields: [projectTemplateId], references: [id], onDelete: Cascade)
  parent            ProjectTemplateSectionFolder?  @relation("ProjectTemplateSectionFolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children          ProjectTemplateSectionFolder[] @relation("ProjectTemplateSectionFolderTree")
  sections          ProjectTemplateSection[]

  @@index([projectTemplateId, parentId, sortOrder])
}

// ── Core models ──

model Project {
  id                    String                @id @default(cuid())
  title                 String
  slug                  String                @unique
  status                String                @default("draft")
  coverImageId          String?
  folderId              String?
  checkpointName        String?
  projectLevelOverrides Json?
  notes                 String?
  publishedAt           DateTime?
  archivedAt            DateTime?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  folder                ProjectFolder?        @relation(fields: [folderId], references: [id], onDelete: SetNull)
  sections              ProjectSection[]
  sectionFolders        ProjectSectionFolder[]
  runs                  Run[]
  censoringTasks        CensoringTask[]
  presetBindingRows     ProjectPresetBinding[]
  @@index([status, updatedAt])
  @@index([coverImageId])
  @@index([folderId])
}

model ProjectPresetBinding {
  id          String         @id @default(cuid())
  projectId   String
  categoryId  String
  presetId    String
  variantId   String?
  sortOrder   Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  category    PresetCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  preset      Preset         @relation(fields: [categoryId, presetId], references: [categoryId, id], onDelete: Restrict)
  variant     PresetVariant? @relation(fields: [presetId, variantId], references: [presetId, id], onDelete: Restrict)

  @@unique([projectId, categoryId])
  @@index([projectId, sortOrder])
  @@index([categoryId])
  @@index([presetId])
  @@index([variantId])
}

model ProjectFolder {
  id          String          @id @default(cuid())
  parentId    String?
  name        String
  sortOrder   Int             @default(0)
  parent      ProjectFolder?  @relation("ProjectFolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children    ProjectFolder[] @relation("ProjectFolderTree")
  projects    Project[]

  @@index([parentId, sortOrder])
}

model ProjectSection {
  id                    String                @id @default(cuid())
  projectId             String
  folderId              String?
  name                  String?
  sortOrder             Int                   @default(0)
  enabled               Boolean               @default(true)
  aspectRatio           String?
  aspectRatios          Json?
  shortSidePx           Int?
  batchSize             Int?
  seedPolicy1           String?
  seedPolicy2           String?
  ksampler1             Json?
  ksampler2             Json?
  upscaleFactor         Float?
  checkpointName        String?
  extraParams           Json?
  latestRunId           String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  project               Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  folder                ProjectSectionFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  runs                  Run[]
  changeLogs            SectionChangeLog[]
  presetBindingRows     SectionPresetBinding[]
  sectionPromptBlocks   SectionPromptBlock[]
  manualLoraEntries     SectionManualLoraEntry[]

  @@index([projectId, sortOrder])
  @@index([folderId])
}

model SectionPresetBinding {
  id                String                   @id @default(cuid())
  projectSectionId  String
  bindingKey        String
  categoryId        String
  presetId          String?
  variantId         String?
  presetGroupId     String?
  groupBindingKey   String?
  sortOrder         Int                      @default(0)
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  projectSection    ProjectSection           @relation(fields: [projectSectionId], references: [id], onDelete: Cascade)
  category          PresetCategory           @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  preset            Preset?                  @relation(fields: [categoryId, presetId], references: [categoryId, id], onDelete: Restrict)
  variant           PresetVariant?           @relation(fields: [presetId, variantId], references: [presetId, id], onDelete: Restrict)
  presetGroup       PresetGroup?             @relation(fields: [presetGroupId], references: [id], onDelete: Restrict)
  promptBlock       SectionPromptBlock?
  manualLoraEntries SectionManualLoraEntry[]

  @@unique([projectSectionId, bindingKey])
  @@unique([projectSectionId, id])
  @@index([projectSectionId, sortOrder])
  @@index([categoryId])
  @@index([presetId])
  @@index([variantId])
  @@index([presetGroupId])
  @@index([groupBindingKey])
}

model SectionPromptBlock {
  id               String                @id @default(cuid())
  projectSectionId String
  sectionBindingId String?               @unique
  type             String                @default("custom")
  customLabel      String?
  customPositive   String?
  customNegative   String?
  sortOrder        Int                   @default(0)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  projectSection   ProjectSection        @relation(fields: [projectSectionId], references: [id], onDelete: Cascade)
  sectionBinding   SectionPresetBinding? @relation(fields: [projectSectionId, sectionBindingId], references: [projectSectionId, id], onDelete: Cascade)

  @@index([projectSectionId, sortOrder])
  @@unique([projectSectionId, sectionBindingId])
}

model SectionManualLoraEntry {
  id               String                @id @default(cuid())
  projectSectionId String
  sectionBindingId String?
  stage            String
  path             String
  weight           Float                 @default(1)
  enabled          Boolean               @default(true)
  detachedFromBindingKey String?
  detachedFromPresetId   String?
  detachedFromVariantId  String?
  detachedFromPath       String?
  metadata         Json?
  sortOrder        Int                   @default(0)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  projectSection   ProjectSection        @relation(fields: [projectSectionId], references: [id], onDelete: Cascade)
  sectionBinding   SectionPresetBinding? @relation(fields: [projectSectionId, sectionBindingId], references: [projectSectionId, id], onDelete: Restrict)

  @@index([projectSectionId, stage, sortOrder])
  @@index([sectionBindingId])
  @@index([detachedFromBindingKey])
}

model ProjectSectionFolder {
  id          String                 @id @default(cuid())
  projectId   String
  parentId    String?
  name        String
  sortOrder   Int                    @default(0)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  project     Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent      ProjectSectionFolder?  @relation("ProjectSectionFolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children    ProjectSectionFolder[] @relation("ProjectSectionFolderTree")
  sections    ProjectSection[]

  @@index([projectId, parentId, sortOrder])
}

model SectionChangeLog {
  id                    String                @id @default(cuid())
  projectSectionId      String
  dimension             String                // "runParams" | "prompt" | "lora"
  title                 String
  before                Json?
  after                 Json?
  createdAt             DateTime              @default(now())
  projectSection        ProjectSection        @relation(fields: [projectSectionId], references: [id], onDelete: Cascade)

  @@index([projectSectionId, dimension, createdAt])
}

model Run {
  id                    String                @id @default(cuid())
  projectId             String
  projectSectionId      String
  runIndex              Int                   @default(1)
  status                String                @default("queued")
  resolvedConfigSnapshot Json
  comfyPromptId         String?
  executionMeta         Json?
  submittedPrompt       Json?               // Full submitted ComfyUI workflow JSON
  outputDir             String?
  comfyOutputSubfolder  String?
  errorMessage          String?
  startedAt             DateTime?
  finishedAt            DateTime?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  project               Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectSection        ProjectSection        @relation(fields: [projectSectionId], references: [id], onDelete: Cascade)
  images                ImageResult[]

  @@index([status, createdAt])
  @@index([projectId, createdAt])
  @@index([projectSectionId, createdAt])
}

model ImageResult {
  id                    String          @id @default(cuid())
  runId                 String
  filePath              String          @unique
  thumbPath             String?
  width                 Int?
  height                Int?
  fileSize              BigInt?
  reviewStatus          String          @default("pending")
  featured              Boolean         @default(false)
  featured2             Boolean         @default(false)
  reviewedAt            DateTime?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  run                   Run             @relation(fields: [runId], references: [id], onDelete: Cascade)
  trashRecord           TrashRecord?
  censoredFilePath      String?
  censoredThumbPath     String?
  censoredAt            DateTime?
  censoringTasks        CensoringTask[]

  @@index([reviewStatus, createdAt])
  @@index([runId, createdAt])
}

model TrashRecord {
  id                    String       @id @default(cuid())
  imageResultId         String       @unique
  originalPath          String
  trashPath             String
  reason                String?
  deletedAt             DateTime     @default(now())
  restoredAt            DateTime?
  actorType             String       @default("user")
  imageResult           ImageResult  @relation(fields: [imageResultId], references: [id], onDelete: Cascade)

  @@index([deletedAt])
  @@index([restoredAt])
}

model CensoringTask {
  id              String       @id @default(cuid())
  projectId       String
  imageResultId   String
  status          String       @default("queued")
  errorMessage    String?
  createdAt       DateTime     @default(now())
  startedAt       DateTime?
  finishedAt      DateTime?
  project         Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  imageResult     ImageResult  @relation(fields: [imageResultId], references: [id], onDelete: Cascade)

  @@index([projectId, status])
  @@index([status, createdAt])
}

model LoraAsset {
  id                    String      @id @default(cuid())
  name                  String
  modelType             String      @default("lora")
  category              String
  fileName              String
  absolutePath          String      @unique
  relativePath          String
  size                  BigInt?
  source                String?
  notes                 String?
  triggerWords          String?     // trigger words for this LoRA
  civitaiLink           String?
  uploadedAt            DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
}

model AuditLog {
  id                    String      @id @default(cuid())
  entityType            String
  entityId              String
  action                String
  payload               Json?
  actorType             String      @default("system")
  createdAt             DateTime    @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([action, createdAt])
}

// Character LoRA training

model CharacterLoraTrainingTemplate {
  id                     String                         @id @default(cuid())
  key                    String                         @unique
  name                   String
  description            String?
  baseFamily             String?
  captionStrategyDefault String                         @default("controllable_identity")
  canonicalDefaults      Json
  promptCardDefaults     Json
  trainingDefaults       Json
  benchmarkDefaults      Json
  promotionDefaults      Json
  isActive               Boolean                        @default(true)
  sortOrder              Int                            @default(0)
  createdAt              DateTime                       @default(now())
  updatedAt              DateTime                       @updatedAt
  jobs                   CharacterLoraTrainingJob[]
  sectionTemplates       CharacterLoraSectionTemplate[]

  @@index([isActive, sortOrder])
}

model CharacterLoraTrainingJob {
  id                         String                         @id @default(cuid())
  slug                       String                         @unique
  characterName              String
  triggerToken               String
  status                     String                         @default("draft")
  phase                      String?
  trainingScope              Json
  captionStrategy            String                         @default("controllable_identity")
  baseCheckpointName         String?
  baseCheckpointPath         String?
  baseCheckpointHash         String?
  baseFamily                 String?
  artifactRoot               String
  currentCanonicalVersionId  String?
  currentPromptCardVersionId String?
  selectedDatasetRevisionId  String?
  promotedPresetId           String?
  trainingTemplateId         String?
  trainingTemplateSnapshot   Json?
  createdBy                  String?
  failureSummary             String?
  createdAt                  DateTime                       @default(now())
  updatedAt                  DateTime                       @updatedAt
  trainingTemplate           CharacterLoraTrainingTemplate? @relation(fields: [trainingTemplateId], references: [id], onDelete: SetNull)
  sourceImages               CharacterLoraSourceImage[]
  canonicalVersions          CharacterLoraCanonicalVersion[]
  promptCardVersions         CharacterLoraPromptCardVersion[]
  sections                   CharacterLoraJobSection[]
  generationRuns             CharacterLoraGenerationRun[]
  candidateImages            CharacterLoraCandidateImage[]
  datasetRevisions           CharacterLoraDatasetRevision[]
  trainingRuns               CharacterLoraTrainingRun[]
  benchmarkRuns              CharacterLoraBenchmarkRun[]
  promotionDecisions         CharacterLoraPromotionDecision[]
  artifacts                  CharacterLoraArtifact[]
  workerTasks                CharacterLoraWorkerTask[]

  @@index([status, updatedAt])
  @@index([triggerToken])
  @@index([baseCheckpointHash])
  @@index([trainingTemplateId])
}

model CharacterLoraSourceImage {
  id         String                   @id @default(cuid())
  jobId      String
  role       String
  artifactId String
  filePath   String
  sha256     String
  width      Int?
  height     Int?
  provenance Json?
  sortOrder  Int                      @default(0)
  createdAt  DateTime                 @default(now())
  job        CharacterLoraTrainingJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, sha256, role])
  @@index([jobId, sortOrder])
}

model CharacterLoraCanonicalVersion {
  id                String                       @id @default(cuid())
  jobId             String
  version           Int
  status            String                       @default("candidate")
  canonicalView     String?
  sourceRunId       String?
  imageArtifactId   String
  selectedAt        DateTime?
  notes             String?
  createdAt         DateTime                     @default(now())
  job               CharacterLoraTrainingJob     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  sourceRun         CharacterLoraGenerationRun?  @relation(fields: [sourceRunId], references: [id], onDelete: SetNull)
  promptCards       CharacterLoraPromptCardVersion[]
  sections          CharacterLoraJobSection[]
  datasetRevisions  CharacterLoraDatasetRevision[]

  @@unique([jobId, version])
  @@index([jobId, status])
  @@index([jobId, canonicalView])
  @@index([sourceRunId])
}

model CharacterLoraPromptCardVersion {
  id                 String                         @id @default(cuid())
  jobId              String
  canonicalVersionId String?
  version            Int
  triggerToken       String
  identityTraits     Json
  outfitTraits       Json
  negativeTraits     Json?
  finalPromptDraft   String
  changeReason       String?
  createdAt          DateTime                       @default(now())
  job                CharacterLoraTrainingJob       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  canonicalVersion   CharacterLoraCanonicalVersion? @relation(fields: [canonicalVersionId], references: [id], onDelete: SetNull)
  sections           CharacterLoraJobSection[]
  datasetRevisions   CharacterLoraDatasetRevision[]

  @@unique([jobId, version])
  @@index([canonicalVersionId])
}

model CharacterLoraSectionTemplate {
  id                   String                    @id @default(cuid())
  trainingTemplateId   String?
  key                  String                    @unique
  name                 String
  description          String?
  angleTag             String?
  promptTemplate       String
  negativeTemplate     String?
  targetCandidateCount Int                       @default(4)
  targetKeepCount      Int                       @default(1)
  sortOrder            Int                       @default(0)
  isActive             Boolean                   @default(true)
  trainingTemplate     CharacterLoraTrainingTemplate? @relation(fields: [trainingTemplateId], references: [id], onDelete: SetNull)
  sections             CharacterLoraJobSection[]

  @@index([isActive, sortOrder])
  @@index([trainingTemplateId, isActive, sortOrder])
}

model CharacterLoraJobSection {
  id                   String                          @id @default(cuid())
  jobId                String
  templateId           String?
  key                  String
  name                 String
  canonicalVersionId   String?
  promptCardVersionId  String?
  targetCandidateCount Int                             @default(4)
  targetKeepCount      Int                             @default(1)
  status               String                          @default("draft")
  keepCount            Int                             @default(0)
  rejectCount          Int                             @default(0)
  pendingCount         Int                             @default(0)
  sortOrder            Int                             @default(0)
  createdAt            DateTime                        @default(now())
  updatedAt            DateTime                        @updatedAt
  job                  CharacterLoraTrainingJob        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  template             CharacterLoraSectionTemplate?   @relation(fields: [templateId], references: [id], onDelete: SetNull)
  canonicalVersion     CharacterLoraCanonicalVersion?  @relation(fields: [canonicalVersionId], references: [id], onDelete: SetNull)
  promptCardVersion    CharacterLoraPromptCardVersion? @relation(fields: [promptCardVersionId], references: [id], onDelete: SetNull)
  generationRuns       CharacterLoraGenerationRun[]
  candidateImages      CharacterLoraCandidateImage[]

  @@unique([jobId, key])
  @@index([jobId, sortOrder])
  @@index([templateId])
}

model CharacterLoraGenerationRun {
  id                String                       @id @default(cuid())
  jobId             String
  sectionId         String?
  kind              String
  canonicalView     String?
  parentRunId       String?
  status            String                       @default("queued")
  provider          String
  hostModel         String?
  imageModel        String
  hostInstruction   String
  visualPrompt      String
  negativePrompt    String?
  toolParams        Json
  inputImages       Json
  requestArtifactId String?
  responseSummary   Json?
  errorSummary      String?
  startedAt         DateTime?
  finishedAt        DateTime?
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt
  job               CharacterLoraTrainingJob     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  section           CharacterLoraJobSection?     @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  parentRun         CharacterLoraGenerationRun?  @relation("CharacterLoraGenerationRunTree", fields: [parentRunId], references: [id], onDelete: SetNull)
  childRuns         CharacterLoraGenerationRun[] @relation("CharacterLoraGenerationRunTree")
  canonicalVersions CharacterLoraCanonicalVersion[]
  candidateImages   CharacterLoraCandidateImage[]

  @@index([jobId, status])
  @@index([jobId, canonicalView])
  @@index([sectionId, createdAt])
  @@index([parentRunId])
}

model CharacterLoraCandidateImage {
  id                        String                           @id @default(cuid())
  jobId                     String
  sectionId                 String?
  generationRunId           String
  artifactId                String
  filePath                  String                           @unique
  sha256                    String
  width                     Int?
  height                    Int?
  fileSize                  BigInt?
  reviewStatus              String                           @default("pending")
  rejectReasons             Json?
  reviewNote                String?
  captionDraft              String?
  reviewedAt                DateTime?
  includedDatasetRevisionId String?
  createdAt                 DateTime                         @default(now())
  updatedAt                 DateTime                         @updatedAt
  job                       CharacterLoraTrainingJob         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  section                   CharacterLoraJobSection?         @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  generationRun             CharacterLoraGenerationRun       @relation(fields: [generationRunId], references: [id], onDelete: Cascade)
  includedDatasetRevision   CharacterLoraDatasetRevision?    @relation("CharacterLoraIncludedDatasetRevision", fields: [includedDatasetRevisionId], references: [id], onDelete: SetNull)
  datasetItems              CharacterLoraDatasetItem[]

  @@index([jobId, reviewStatus])
  @@index([sectionId, reviewStatus])
  @@index([generationRunId])
  @@index([includedDatasetRevisionId])
}

model CharacterLoraDatasetRevision {
  id                         String                           @id @default(cuid())
  jobId                      String
  version                    Int
  status                     String                           @default("freezing")
  canonicalVersionId         String
  promptCardVersionId        String
  captionStrategy            String                           @default("controllable_identity")
  itemCount                  Int                              @default(0)
  sourceCount                Int                              @default(0)
  syntheticCount             Int                              @default(0)
  selectedManifestArtifactId String
  metadataJsonlArtifactId    String
  captionAuditArtifactId     String?
  trainDir                   String
  frozenAt                   DateTime?
  createdAt                  DateTime                         @default(now())
  updatedAt                  DateTime                         @updatedAt
  job                        CharacterLoraTrainingJob         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  canonicalVersion           CharacterLoraCanonicalVersion    @relation(fields: [canonicalVersionId], references: [id], onDelete: Restrict)
  promptCardVersion          CharacterLoraPromptCardVersion   @relation(fields: [promptCardVersionId], references: [id], onDelete: Restrict)
  includedCandidateImages    CharacterLoraCandidateImage[]    @relation("CharacterLoraIncludedDatasetRevision")
  items                      CharacterLoraDatasetItem[]
  trainingRuns               CharacterLoraTrainingRun[]

  @@unique([jobId, version])
  @@index([jobId, status])
  @@index([canonicalVersionId])
  @@index([promptCardVersionId])
}

model CharacterLoraDatasetItem {
  id                String                         @id @default(cuid())
  datasetRevisionId String
  candidateImageId  String
  imageArtifactId   String
  captionArtifactId String
  captionText       String
  repeatCount       Int                            @default(1)
  sourceWeight      Float?
  sortOrder         Int                            @default(0)
  datasetRevision   CharacterLoraDatasetRevision   @relation(fields: [datasetRevisionId], references: [id], onDelete: Cascade)
  candidateImage    CharacterLoraCandidateImage    @relation(fields: [candidateImageId], references: [id], onDelete: Restrict)

  @@unique([datasetRevisionId, candidateImageId])
  @@index([datasetRevisionId, sortOrder])
  @@index([candidateImageId])
}

model CharacterLoraTrainingRun {
  id                         String                         @id @default(cuid())
  jobId                      String
  datasetRevisionId          String
  status                     String                         @default("queued")
  launcher                   String
  resolvedConfig             Json
  configArtifactId           String
  dryRunSummaryArtifactId    String?
  logArtifactId              String?
  outputDir                  String?
  finalSafetensorsArtifactId String?
  finalSha256                String?
  metadataSummary            Json?
  currentStep                Int?
  targetSteps                Int?
  lossSnapshot               Json?
  cancelRequestedAt          DateTime?
  startedAt                  DateTime?
  finishedAt                 DateTime?
  createdAt                  DateTime                       @default(now())
  updatedAt                  DateTime                       @updatedAt
  job                        CharacterLoraTrainingJob       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  datasetRevision            CharacterLoraDatasetRevision   @relation(fields: [datasetRevisionId], references: [id], onDelete: Restrict)
  checkpoints                CharacterLoraTrainingCheckpoint[]
  benchmarkRuns              CharacterLoraBenchmarkRun[]

  @@index([jobId, status])
  @@index([datasetRevisionId])
  @@index([finalSha256])
}

model CharacterLoraTrainingCheckpoint {
  id            String                    @id @default(cuid())
  trainingRunId String
  step          Int
  artifactId    String
  sha256        String
  metrics       Json?
  createdAt     DateTime                  @default(now())
  trainingRun   CharacterLoraTrainingRun  @relation(fields: [trainingRunId], references: [id], onDelete: Cascade)

  @@unique([trainingRunId, step])
  @@index([trainingRunId, step])
  @@index([sha256])
}

model CharacterLoraBenchmarkRun {
  id                 String                           @id @default(cuid())
  jobId              String
  trainingRunId      String
  status             String                           @default("queued")
  loraAssetId        String?
  testPresetId       String?
  testProjectId      String?
  templateId         String?
  checkpointMatrix   Json
  weightMatrix       Json
  reportArtifactId   String?
  recommendedWeight  Float?
  resultSummary      Json?
  testPresetCleanedAt  DateTime?
  testProjectCleanedAt DateTime?
  cleanupSummary       Json?
  startedAt          DateTime?
  finishedAt         DateTime?
  createdAt          DateTime                         @default(now())
  updatedAt          DateTime                         @updatedAt
  job                CharacterLoraTrainingJob         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  trainingRun        CharacterLoraTrainingRun         @relation(fields: [trainingRunId], references: [id], onDelete: Restrict)
  promotionDecisions CharacterLoraPromotionDecision[]

  @@index([jobId, status])
  @@index([trainingRunId])
  @@index([testProjectId])
}

model CharacterLoraPromotionDecision {
  id                        String                         @id @default(cuid())
  jobId                     String
  benchmarkRunId            String
  status                    String                         @default("draft")
  selectedLoraAssetId       String
  selectedCheckpoint        String?
  defaultRecommendedWeight  Float
  perVariantWeightOverrides Json?
  variantPromptDrafts       Json
  decisionReason            String?
  rejectedReturnPoint       String?
  promotedCategoryId        String?
  promotedPresetId          String?
  reportArtifactId          String?
  decidedAt                 DateTime?
  promotedAt                DateTime?
  createdAt                 DateTime                       @default(now())
  updatedAt                 DateTime                       @updatedAt
  job                       CharacterLoraTrainingJob       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  benchmarkRun              CharacterLoraBenchmarkRun      @relation(fields: [benchmarkRunId], references: [id], onDelete: Restrict)

  @@index([jobId, status])
  @@index([benchmarkRunId])
  @@index([selectedLoraAssetId])
}

model CharacterLoraArtifact {
  id             String                   @id @default(cuid())
  jobId          String
  kind           String
  relativePath   String
  absolutePath   String?
  sha256         String?
  byteSize       BigInt?
  mimeType       String?
  redactionLevel String                   @default("path_only")
  metadata       Json?
  createdAt      DateTime                 @default(now())
  job            CharacterLoraTrainingJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, relativePath])
  @@index([jobId, kind])
  @@index([sha256])
}

model CharacterLoraWorkerTask {
  id             String                   @id @default(cuid())
  jobId          String
  workerType     String
  targetType     String
  targetId       String
  status         String                   @default("queued")
  payload        Json
  leaseOwner     String?
  leaseExpiresAt DateTime?
  attemptCount   Int                      @default(0)
  progressJson   Json?
  startedAt      DateTime?
  heartbeatAt    DateTime?
  finishedAt     DateTime?
  errorSummary   String?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  job            CharacterLoraTrainingJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([status, leaseExpiresAt])
  @@index([jobId, workerType, status])
  @@index([targetType, targetId])
}

model GpuTaskLock {
  id         String    @id @default(cuid())
  taskType   String
  ownerType  String
  ownerId    String
  status     String    @default("active")
  startedAt  DateTime  @default(now())
  releasedAt DateTime?
  metadata   Json?

  @@index([status, startedAt])
  @@index([ownerType, ownerId])
  @@index([taskType, status])
}
