generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma-sqlite"
}

datasource db {
  provider = "sqlite"
}

// Note: SQLite does not enforce enum values at the database level.
// Prisma handles validation at the application layer.

// ── Preset system ──

model PresetCategory {
  id                      String                         @id @default(cuid())
  name                    String // e.g. "角色", "场景", "风格", "镜位"
  slug                    String                         @unique
  icon                    String? // lucide icon name for UI badge
  color                   String? // HSL color string
  positivePromptOrder     Int                            @default(0)
  negativePromptOrder     Int                            @default(0)
  lora1Order              Int                            @default(0)
  lora2Order              Int                            @default(0)
  sortOrder               Int                            @default(0)
  type                    String                         @default("preset") // "preset" | "group"
  createdAt               DateTime                       @default(now())
  updatedAt               DateTime                       @updatedAt
  presets                 Preset[]
  groups                  PresetGroup[]
  folders                 PresetFolder[]
  ownedSlots              PresetCategorySlot[]           @relation("PresetCategorySlotOwner")
  usedInSlots             PresetCategorySlot[]           @relation("PresetCategorySlotTarget")
  projectBindings         ProjectPresetBinding[]
  templateBindings        ProjectTemplatePresetBinding[]
  sectionBindings         SectionPresetBinding[]
  templateSectionBindings TemplateSectionPresetBinding[]
}

model Preset {
  id                      String                         @id @default(cuid())
  categoryId              String
  name                    String
  slug                    String
  isActive                Boolean                        @default(true)
  sortOrder               Int                            @default(0)
  notes                   String?
  civitaiLinks            Json? // string[] — external Civitai model/version URLs
  folderId                String?
  createdAt               DateTime                       @default(now())
  updatedAt               DateTime                       @updatedAt
  category                PresetCategory                 @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  folder                  PresetFolder?                  @relation(fields: [folderId], references: [id], onDelete: SetNull)
  variants                PresetVariant[]
  changeLogs              PresetChangeLog[]
  projectBindings         ProjectPresetBinding[]
  templateBindings        ProjectTemplatePresetBinding[]
  sectionBindings         SectionPresetBinding[]
  templateSectionBindings TemplateSectionPresetBinding[]

  @@unique([categoryId, slug])
  @@unique([categoryId, id])
  @@index([categoryId, sortOrder])
}

model PresetVariant {
  id                      String                         @id @default(cuid())
  presetId                String
  name                    String
  slug                    String
  prompt                  String // positive prompt
  negativePrompt          String?
  lora1                   Json? // Array<LoraBinding> — stage 1
  lora2                   Json? // Array<LoraBinding> — stage 2 (upscale)
  sortOrder               Int                            @default(0)
  isActive                Boolean                        @default(true)
  createdAt               DateTime                       @default(now())
  updatedAt               DateTime                       @updatedAt
  preset                  Preset                         @relation(fields: [presetId], references: [id], onDelete: Cascade)
  outgoingLinks           PresetVariantLink[]            @relation("PresetVariantLinkSource")
  incomingLinks           PresetVariantLink[]            @relation("PresetVariantLinkTarget")
  projectBindings         ProjectPresetBinding[]
  templateBindings        ProjectTemplatePresetBinding[]
  sectionBindings         SectionPresetBinding[]
  templateSectionBindings TemplateSectionPresetBinding[]

  @@unique([presetId, slug])
  @@unique([presetId, id])
  @@index([presetId, sortOrder])
}

model PresetVariantLink {
  id              String        @id @default(cuid())
  sourceVariantId String
  linkedVariantId String
  sortOrder       Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  sourceVariant   PresetVariant @relation("PresetVariantLinkSource", fields: [sourceVariantId], references: [id], onDelete: Cascade)
  linkedVariant   PresetVariant @relation("PresetVariantLinkTarget", fields: [linkedVariantId], references: [id], onDelete: Cascade)

  @@unique([sourceVariantId, linkedVariantId])
  @@index([sourceVariantId, sortOrder])
  @@index([linkedVariantId])
}

model PresetGroup {
  id                      String                         @id @default(cuid())
  categoryId              String
  name                    String
  slug                    String
  sortOrder               Int                            @default(0)
  isActive                Boolean                        @default(true)
  folderId                String?
  createdAt               DateTime                       @default(now())
  updatedAt               DateTime                       @updatedAt
  category                PresetCategory                 @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  folder                  PresetFolder?                  @relation(fields: [folderId], references: [id], onDelete: SetNull)
  members                 PresetGroupMember[]
  changeLogs              PresetGroupChangeLog[]
  sectionBindings         SectionPresetBinding[]
  templateSectionBindings TemplateSectionPresetBinding[]

  @@unique([categoryId, slug])
  @@index([categoryId, sortOrder])
}

model PresetChangeLog {
  id        String   @id @default(cuid())
  presetId  String
  dimension String // "variants" | "content"
  title     String
  before    Json?
  after     Json?
  createdAt DateTime @default(now())
  preset    Preset   @relation(fields: [presetId], references: [id], onDelete: Cascade)

  @@index([presetId, dimension, createdAt])
}

model PresetGroupChangeLog {
  id            String      @id @default(cuid())
  presetGroupId String
  dimension     String // "meta" | "members"
  title         String
  before        Json?
  after         Json?
  createdAt     DateTime    @default(now())
  presetGroup   PresetGroup @relation(fields: [presetGroupId], references: [id], onDelete: Cascade)

  @@index([presetGroupId, dimension, createdAt])
}

model PresetGroupMember {
  id             String      @id @default(cuid())
  groupId        String
  presetId       String? // reference a preset (+ optional variantId)
  variantId      String? // specific variant of the preset
  subGroupId     String? // or reference another group (mutually exclusive with presetId)
  slotCategoryId String? // if from slot template, locks to this category
  sortOrder      Int         @default(0)
  group          PresetGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId, sortOrder])
}

model PresetCategorySlot {
  id             String         @id @default(cuid())
  categoryId     String
  slotKey        String
  slotCategoryId String
  label          String?
  sortOrder      Int            @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  category       PresetCategory @relation("PresetCategorySlotOwner", fields: [categoryId], references: [id], onDelete: Cascade)
  slotCategory   PresetCategory @relation("PresetCategorySlotTarget", fields: [slotCategoryId], references: [id], onDelete: Restrict)

  @@unique([categoryId, slotKey])
  @@index([categoryId, sortOrder])
  @@index([slotCategoryId])
}

model PresetFolder {
  id         String         @id @default(cuid())
  categoryId String
  parentId   String?
  name       String
  sortOrder  Int            @default(0)
  category   PresetCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  parent     PresetFolder?  @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children   PresetFolder[] @relation("FolderTree")
  presets    Preset[]
  groups     PresetGroup[]

  @@index([categoryId, parentId, sortOrder])
}

// ── Training Scene Description Presets ──

model TrainingSceneDescriptionPresetCategory {
  id                    String   @id @default(cuid())
  name                  String
  slug                  String   @unique
  icon                  String?
  color                 String?
  sortOrder             Int      @default(0)
  sceneDescriptionOrder Int      @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  folders        TrainingSceneDescriptionPresetFolder[]
  presets        TrainingSceneDescriptionPreset[]
  templateBlocks TrainingTemplateSectionSceneDescriptionBlock[]
  projectBlocks  TrainingSceneDescriptionBlock[]

  @@index([sortOrder])
  @@index([sceneDescriptionOrder])
}

model TrainingSceneDescriptionPresetFolder {
  id         String   @id @default(cuid())
  categoryId String
  parentId   String?
  name       String
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  category TrainingSceneDescriptionPresetCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  parent   TrainingSceneDescriptionPresetFolder?  @relation("TrainingSceneDescriptionPresetFolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children TrainingSceneDescriptionPresetFolder[] @relation("TrainingSceneDescriptionPresetFolderTree")
  presets  TrainingSceneDescriptionPreset[]

  @@index([categoryId, parentId, sortOrder])
}

model TrainingSceneDescriptionPreset {
  id                   String   @id @default(cuid())
  categoryId           String
  folderId             String?
  name                 String
  slug                 String
  sceneDescriptionText String
  notes                String?
  sortOrder            Int      @default(0)
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  category       TrainingSceneDescriptionPresetCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  folder         TrainingSceneDescriptionPresetFolder?  @relation(fields: [folderId], references: [id], onDelete: SetNull)
  templateBlocks TrainingTemplateSectionSceneDescriptionBlock[]
  projectBlocks  TrainingSceneDescriptionBlock[]

  @@unique([categoryId, slug])
  @@unique([categoryId, id])
  @@index([categoryId, folderId, sortOrder])
  @@index([isActive, sortOrder])
}

// ── Training Templates ──

model TrainingTemplate {
  id                    String                    @id @default(cuid())
  name                  String
  slug                  String?                   @unique
  description           String?
  imagePromptGuidance   String
  imagePromptFormat     String
  captioningGuidance    String
  trainingCaptionFormat String
  trainingDefaultsJson  Json?
  sortOrder             Int                       @default(0)
  isActive              Boolean                   @default(true)
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt
  sections              TrainingTemplateSection[]

  @@index([isActive, sortOrder])
}

model TrainingTemplateSection {
  id                  String                                           @id @default(cuid())
  trainingTemplateId  String
  name                String?
  sortOrder           Int                                              @default(0)
  enabled             Boolean                                          @default(true)
  sectionDefaultsJson Json?
  createdAt           DateTime                                         @default(now())
  updatedAt           DateTime                                         @updatedAt
  template            TrainingTemplate                                 @relation(fields: [trainingTemplateId], references: [id], onDelete: Cascade)
  blocks              TrainingTemplateSectionSceneDescriptionBlock[]

  @@index([trainingTemplateId, sortOrder])
}

model TrainingTemplateSectionSceneDescriptionBlock {
  id                               String                                  @id @default(cuid())
  trainingTemplateSectionId        String
  sceneDescriptionPresetCategoryId String?
  sceneDescriptionPresetId         String?
  sourceType                       String
  title                            String
  localText                        String?
  sortOrder                        Int                                     @default(0)
  enabled                          Boolean                                 @default(true)
  createdAt                        DateTime                                @default(now())
  updatedAt                        DateTime                                @updatedAt
  section                          TrainingTemplateSection                 @relation(fields: [trainingTemplateSectionId], references: [id], onDelete: Cascade)
  category                         TrainingSceneDescriptionPresetCategory? @relation(fields: [sceneDescriptionPresetCategoryId], references: [id], onDelete: SetNull)
  preset                           TrainingSceneDescriptionPreset?         @relation(fields: [sceneDescriptionPresetId], references: [id], onDelete: SetNull)

  @@index([trainingTemplateSectionId, sortOrder])
  @@index([sceneDescriptionPresetCategoryId], map: "training_template_block_category_idx")
  @@index([sceneDescriptionPresetId], map: "training_template_block_preset_idx")
}

// ── Training Projects and Runs ──

model TrainingProject {
  id                    String    @id @default(cuid())
  name                  String
  slug                  String    @unique
  status                String    @default("active")
  archivedAt            DateTime?
  imagePromptGuidance   String
  imagePromptFormat     String
  captioningGuidance    String
  trainingCaptionFormat String
  trainingDefaultsJson  Json?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  profile          TrainingCharacterProfile?
  sections         TrainingSection[]
  sectionRuns      TrainingSectionRun[]
  generationTasks  TrainingGenerationTask[]
  datasetRevisions TrainingDatasetRevision[]
  trainingRuns     TrainingRun[]
  textRevisions    TrainingTextRevision[]
  artifacts        TrainingArtifact[]
  imageResults     TrainingImageResult[]

  @@index([status, updatedAt])
  @@index([createdAt])
}

model TrainingCharacterProfile {
  id                                    String   @id @default(cuid())
  trainingProjectId                     String   @unique
  loraUsagePrompt                       String   @default("")
  characterDetailPrompt                 String   @default("")
  loraUsagePromptGenerationTaskId       String?
  characterDetailPromptGenerationTaskId String?
  createdAt                             DateTime @default(now())
  updatedAt                             DateTime @updatedAt

  project         TrainingProject          @relation(fields: [trainingProjectId], references: [id], onDelete: Cascade)
  referenceImages TrainingCharacterImage[]
  sectionRuns     TrainingSectionRun[]
  imageResults    TrainingImageResult[]

  @@index([trainingProjectId])
}

model TrainingCharacterImage {
  id                           String   @id @default(cuid())
  trainingCharacterProfileId   String
  artifactId                   String
  imageType                    String
  label                        String?
  note                         String?
  sortOrder                    Int      @default(0)
  sourceGenerationTaskOutputId String?
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt

  profile                    TrainingCharacterProfile    @relation(fields: [trainingCharacterProfileId], references: [id], onDelete: Cascade)
  artifact                   TrainingArtifact            @relation("TrainingCharacterImageArtifact", fields: [artifactId], references: [id], onDelete: Restrict)
  sourceGenerationTaskOutput TrainingGenerationTaskOutput? @relation("TrainingCharacterImageSourceOutput", fields: [sourceGenerationTaskOutputId], references: [id], onDelete: SetNull)

  @@index([trainingCharacterProfileId, sortOrder])
  @@index([artifactId])
  @@index([sourceGenerationTaskOutputId])
}

model TrainingArtifact {
  id              String   @id @default(cuid())
  trainingProjectId String
  storageKey      String
  filePath        String?
  storageRole     String   @default("mutable_source")
  mimeType        String?
  fileSize        BigInt?
  sha256          String?
  width           Int?
  height          Int?
  lifecycleStatus String   @default("active")
  metadata        Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  project                          TrainingProject                    @relation(fields: [trainingProjectId], references: [id], onDelete: Cascade)
  characterImages                  TrainingCharacterImage[]           @relation("TrainingCharacterImageArtifact")
  generationInputArtifacts         TrainingGenerationInputReference[] @relation("TrainingGenerationInputArtifact")
  generationInputSnapshotArtifacts TrainingGenerationInputReference[] @relation("TrainingGenerationInputSnapshotArtifact")
  generationOutputs                TrainingGenerationTaskOutput[]     @relation("TrainingGenerationOutputArtifact")
  imageResults                     TrainingImageResult[]              @relation("TrainingImageResultArtifact")
  imageResultThumbnails            TrainingImageResult[]              @relation("TrainingImageResultThumbnailArtifact")
  datasetRevisionManifests         TrainingDatasetRevision[]          @relation("TrainingDatasetRevisionManifestArtifact")
  datasetItemSourceArtifacts       TrainingDatasetRevisionItem[]      @relation("TrainingDatasetItemSourceArtifact")
  datasetItemSnapshotArtifacts     TrainingDatasetRevisionItem[]      @relation("TrainingDatasetItemSnapshotArtifact")
  runConfigArtifacts               TrainingRun[]                      @relation("TrainingRunConfigArtifact")
  runLogArtifacts                  TrainingRun[]                      @relation("TrainingRunLogArtifact")
  runFinalArtifacts                TrainingRun[]                      @relation("TrainingRunFinalArtifact")

  @@unique([trainingProjectId, storageKey])
  @@index([trainingProjectId, storageRole])
  @@index([sha256])
  @@index([lifecycleStatus])
}

model TrainingSection {
  id                  String   @id @default(cuid())
  trainingProjectId   String
  name                String?
  sortOrder           Int      @default(0)
  enabled             Boolean  @default(true)
  sectionDefaultsJson Json?
  latestRunId         String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  project TrainingProject                 @relation(fields: [trainingProjectId], references: [id], onDelete: Cascade)
  blocks  TrainingSceneDescriptionBlock[]
  runs    TrainingSectionRun[]

  @@index([trainingProjectId, sortOrder])
  @@index([latestRunId])
}

model TrainingSceneDescriptionBlock {
  id                               String   @id @default(cuid())
  trainingSectionId                String
  sceneDescriptionPresetCategoryId String?
  sceneDescriptionPresetId         String?
  sourceType                       String
  title                            String
  localText                        String?
  sortOrder                        Int      @default(0)
  enabled                          Boolean  @default(true)
  createdAt                        DateTime @default(now())
  updatedAt                        DateTime @updatedAt

  section  TrainingSection                         @relation(fields: [trainingSectionId], references: [id], onDelete: Cascade)
  category TrainingSceneDescriptionPresetCategory? @relation(fields: [sceneDescriptionPresetCategoryId], references: [id], onDelete: SetNull)
  preset   TrainingSceneDescriptionPreset?         @relation(fields: [sceneDescriptionPresetId], references: [id], onDelete: SetNull)

  @@index([trainingSectionId, sortOrder])
  @@index([sceneDescriptionPresetCategoryId], map: "training_project_block_category_idx")
  @@index([sceneDescriptionPresetId], map: "training_project_block_preset_idx")
}

model TrainingSectionRun {
  id                         String   @id @default(cuid())
  trainingProjectId          String
  trainingSectionId          String
  trainingCharacterProfileId String
  generationTaskId           String
  runIndex                   Int      @default(1)
  sceneDescriptionText       String
  imagePromptText            String
  provider                   String?
  model                      String?
  generationParamsJson       Json?
  status                     String   @default("queued")
  errorMessage               String?
  startedAt                  DateTime?
  finishedAt                 DateTime?
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  project        TrainingProject          @relation(fields: [trainingProjectId], references: [id], onDelete: Cascade)
  section        TrainingSection          @relation(fields: [trainingSectionId], references: [id], onDelete: Cascade)
  profile        TrainingCharacterProfile @relation(fields: [trainingCharacterProfileId], references: [id], onDelete: Restrict)
  generationTask TrainingGenerationTask   @relation("TrainingSectionRunGenerationTask", fields: [generationTaskId], references: [id], onDelete: Restrict)
  imageResults   TrainingImageResult[]

  @@index([trainingProjectId, status])
  @@index([trainingSectionId, createdAt])
  @@index([generationTaskId])
}

model TrainingImageResult {
  id                         String   @id @default(cuid())
  trainingProjectId          String
  trainingCharacterProfileId String?
  artifactId                 String
  sourceType                 String
  trainingSectionRunId       String?
  generationTaskOutputId     String?
  reviewStatus               String   @default("pending")
  trainingCaption            String?
  captionGenerationTaskId    String?
  supplementalPrompt         String?
  removedAt                  DateTime?
  removeReason               String?
  filePathSnapshot           String?
  thumbnailArtifactId        String?
  width                      Int?
  height                     Int?
  mimeType                   String?
  fileSize                   BigInt?
  sha256                     String?
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  project               TrainingProject              @relation(fields: [trainingProjectId], references: [id], onDelete: Cascade)
  profile               TrainingCharacterProfile?     @relation(fields: [trainingCharacterProfileId], references: [id], onDelete: SetNull)
  artifact              TrainingArtifact              @relation("TrainingImageResultArtifact", fields: [artifactId], references: [id], onDelete: Restrict)
  thumbnailArtifact     TrainingArtifact?             @relation("TrainingImageResultThumbnailArtifact", fields: [thumbnailArtifactId], references: [id], onDelete: SetNull)
  sectionRun            TrainingSectionRun?           @relation(fields: [trainingSectionRunId], references: [id], onDelete: SetNull)
  generationTaskOutput  TrainingGenerationTaskOutput? @relation("TrainingImageResultGenerationOutput", fields: [generationTaskOutputId], references: [id], onDelete: SetNull)
  captionGenerationTask TrainingGenerationTask?       @relation("TrainingImageResultCaptionTask", fields: [captionGenerationTaskId], references: [id], onDelete: SetNull)
  datasetItems          TrainingDatasetRevisionItem[]

  @@index([trainingProjectId, reviewStatus])
  @@index([trainingSectionRunId])
  @@index([artifactId])
  @@index([removedAt])
}

model TrainingGenerationTask {
  id                 String   @id @default(cuid())
  trainingProjectId  String
  generationKind     String
  taskType           String
  supplementalPrompt String?
  status             String   @default("queued")
  provider           String?
  model              String?
  paramsJson         Json?
  errorMessage       String?
  startedAt          DateTime?
  finishedAt         DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  project               TrainingProject                    @relation(fields: [trainingProjectId], references: [id], onDelete: Cascade)
  inputs                TrainingGenerationInputReference[]
  outputs               TrainingGenerationTaskOutput[]
  sectionRuns           TrainingSectionRun[]               @relation("TrainingSectionRunGenerationTask")
  captionedImageResults TrainingImageResult[]              @relation("TrainingImageResultCaptionTask")

  @@index([trainingProjectId, status])
  @@index([taskType, status])
  @@index([status, createdAt])
}

model TrainingGenerationInputReference {
  id                       String   @id @default(cuid())
  trainingGenerationTaskId String
  inputKind                String
  sourceEntityType         String?
  sourceEntityId           String?
  sourceField              String?
  artifactId               String?
  snapshotText             String?
  snapshotArtifactId       String?
  snapshotFilePath         String?
  role                     String?
  purpose                  String?
  sortOrder                Int      @default(0)
  createdAt                DateTime @default(now())

  task             TrainingGenerationTask @relation(fields: [trainingGenerationTaskId], references: [id], onDelete: Cascade)
  artifact         TrainingArtifact?      @relation("TrainingGenerationInputArtifact", fields: [artifactId], references: [id], onDelete: SetNull)
  snapshotArtifact TrainingArtifact?      @relation("TrainingGenerationInputSnapshotArtifact", fields: [snapshotArtifactId], references: [id], onDelete: SetNull)

  @@index([trainingGenerationTaskId, sortOrder])
  @@index([sourceEntityType, sourceEntityId])
  @@index([artifactId])
}

model TrainingGenerationTaskOutput {
  id                       String   @id @default(cuid())
  trainingGenerationTaskId String
  outputKind               String
  textValue                String?
  artifactId               String?
  filePath                 String?
  targetEntityType         String?
  targetEntityId           String?
  targetField              String?
  appliedAt                DateTime?
  createdAt                DateTime @default(now())

  task            TrainingGenerationTask  @relation(fields: [trainingGenerationTaskId], references: [id], onDelete: Cascade)
  artifact        TrainingArtifact?       @relation("TrainingGenerationOutputArtifact", fields: [artifactId], references: [id], onDelete: SetNull)
  characterImages TrainingCharacterImage[] @relation("TrainingCharacterImageSourceOutput")
  imageResults    TrainingImageResult[]    @relation("TrainingImageResultGenerationOutput")

  @@index([trainingGenerationTaskId, createdAt])
  @@index([artifactId])
  @@index([targetEntityType, targetEntityId])
}

model TrainingDatasetRevision {
  id                  String   @id @default(cuid())
  trainingProjectId   String
  version             Int
  status              String   @default("ready")
  itemCount           Int      @default(0)
  captionMissingCount Int      @default(0)
  manifestArtifactId  String?
  manifestName        String?
  frozenAt            DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  project          TrainingProject               @relation(fields: [trainingProjectId], references: [id], onDelete: Cascade)
  manifestArtifact TrainingArtifact?             @relation("TrainingDatasetRevisionManifestArtifact", fields: [manifestArtifactId], references: [id], onDelete: SetNull)
  items            TrainingDatasetRevisionItem[]
  trainingRuns     TrainingRun[]

  @@unique([trainingProjectId, version])
  @@index([trainingProjectId, status])
}

model TrainingDatasetRevisionItem {
  id                          String   @id @default(cuid())
  trainingDatasetRevisionId   String
  sourceTrainingImageResultId String
  sourceArtifactId            String
  snapshotArtifactId          String
  filePathSnapshot            String
  captionSnapshot             String
  loraUsagePromptSnapshot     String?
  sceneDescriptionText        String?
  supplementalPromptSnapshot  String?
  captionContextSnapshot      Json?
  width                       Int?
  height                      Int?
  aspectBucket                String?
  sortOrder                   Int      @default(0)
  createdAt                   DateTime @default(now())

  revision                  TrainingDatasetRevision @relation(fields: [trainingDatasetRevisionId], references: [id], onDelete: Cascade)
  sourceTrainingImageResult TrainingImageResult     @relation(fields: [sourceTrainingImageResultId], references: [id], onDelete: Restrict)
  sourceArtifact            TrainingArtifact        @relation("TrainingDatasetItemSourceArtifact", fields: [sourceArtifactId], references: [id], onDelete: Restrict)
  snapshotArtifact          TrainingArtifact        @relation("TrainingDatasetItemSnapshotArtifact", fields: [snapshotArtifactId], references: [id], onDelete: Restrict)

  @@unique([trainingDatasetRevisionId, sourceTrainingImageResultId])
  @@index([trainingDatasetRevisionId, sortOrder])
  @@index([sourceTrainingImageResultId])
}

model TrainingRun {
  id                        String   @id @default(cuid())
  trainingProjectId         String
  trainingDatasetRevisionId String
  status                    String   @default("queued")
  baseCheckpointId          String?
  configArtifactId          String?
  trainingLogArtifactId     String?
  finalLoraArtifactId       String?
  runSummaryJson            Json?
  progressJson              Json?
  currentStep               Int?
  totalSteps                Int?
  waitReason                String?
  waitingSince              DateTime?
  schedulerMessage          String?
  runnerType                String   @default("local_wsl_sd_scripts")
  runnerWorkspacePath       String?
  errorMessage              String?
  createdPresetId           String?
  createdPresetVariantId    String?
  presetCreatedAt           DateTime?
  cancelRequestedAt         DateTime?
  startedAt                 DateTime?
  finishedAt                DateTime?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  project         TrainingProject         @relation(fields: [trainingProjectId], references: [id], onDelete: Cascade)
  datasetRevision TrainingDatasetRevision @relation(fields: [trainingDatasetRevisionId], references: [id], onDelete: Restrict)
  configArtifact  TrainingArtifact?       @relation("TrainingRunConfigArtifact", fields: [configArtifactId], references: [id], onDelete: SetNull)
  logArtifact     TrainingArtifact?       @relation("TrainingRunLogArtifact", fields: [trainingLogArtifactId], references: [id], onDelete: SetNull)
  finalArtifact   TrainingArtifact?       @relation("TrainingRunFinalArtifact", fields: [finalLoraArtifactId], references: [id], onDelete: SetNull)

  @@index([trainingProjectId, status])
  @@index([trainingDatasetRevisionId])
  @@index([status, createdAt])
  @@index([finalLoraArtifactId])
}

model TrainingTextRevision {
  id                String   @id @default(cuid())
  trainingProjectId String
  entityType        String
  entityId          String
  fieldName         String
  textValue         String
  reason            String
  sourceTaskId      String?
  sourceRunId       String?
  createdAt         DateTime @default(now())

  project TrainingProject @relation(fields: [trainingProjectId], references: [id], onDelete: Cascade)

  @@index([trainingProjectId, entityType, entityId, fieldName, createdAt])
  @@index([sourceTaskId])
  @@index([sourceRunId])
}

// ── Project Templates ──

model ProjectTemplate {
  id                String                         @id @default(cuid())
  name              String
  description       String?
  createdAt         DateTime                       @default(now())
  updatedAt         DateTime                       @updatedAt
  sections          ProjectTemplateSection[]
  sectionFolders    ProjectTemplateSectionFolder[]
  presetBindingRows ProjectTemplatePresetBinding[]

  @@index([createdAt])
}

model ProjectTemplatePresetBinding {
  id                String          @id @default(cuid())
  projectTemplateId String
  categoryId        String
  presetId          String
  variantId         String?
  sortOrder         Int             @default(0)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  projectTemplate   ProjectTemplate @relation(fields: [projectTemplateId], references: [id], onDelete: Cascade)
  category          PresetCategory  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  preset            Preset          @relation(fields: [categoryId, presetId], references: [categoryId, id], onDelete: Restrict)
  variant           PresetVariant?  @relation(fields: [presetId, variantId], references: [presetId, id], onDelete: Restrict)

  @@unique([projectTemplateId, categoryId])
  @@index([projectTemplateId, sortOrder])
  @@index([categoryId])
  @@index([presetId])
  @@index([variantId])
}

model ProjectTemplateSection {
  id                String                           @id @default(cuid())
  projectTemplateId String
  folderId          String?
  sortOrder         Int                              @default(0)
  name              String?
  notes             String?
  aspectRatio       String?
  aspectRatios      Json?
  shortSidePx       Int?
  batchSize         Int?
  seedPolicy1       String?
  seedPolicy2       String?
  ksampler1         Json?
  ksampler2         Json?
  upscaleFactor     Float?
  checkpointName    String?
  extraParams       Json?
  projectTemplate   ProjectTemplate                  @relation(fields: [projectTemplateId], references: [id], onDelete: Cascade)
  folder            ProjectTemplateSectionFolder?    @relation(fields: [folderId], references: [id], onDelete: SetNull)
  presetBindingRows TemplateSectionPresetBinding[]
  promptBlockRows   TemplateSectionPromptBlock[]
  manualLoraEntries TemplateSectionManualLoraEntry[]

  @@index([projectTemplateId, sortOrder])
  @@index([folderId])
}

model TemplateSectionPresetBinding {
  id                       String                           @id @default(cuid())
  projectTemplateSectionId String
  bindingKey               String
  categoryId               String
  presetId                 String?
  variantId                String?
  presetGroupId            String?
  groupBindingKey          String?
  sortOrder                Int                              @default(0)
  createdAt                DateTime                         @default(now())
  updatedAt                DateTime                         @updatedAt
  projectTemplateSection   ProjectTemplateSection           @relation(fields: [projectTemplateSectionId], references: [id], onDelete: Cascade)
  category                 PresetCategory                   @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  preset                   Preset?                          @relation(fields: [categoryId, presetId], references: [categoryId, id], onDelete: Restrict)
  variant                  PresetVariant?                   @relation(fields: [presetId, variantId], references: [presetId, id], onDelete: Restrict)
  presetGroup              PresetGroup?                     @relation(fields: [presetGroupId], references: [id], onDelete: Restrict)
  promptBlock              TemplateSectionPromptBlock?
  manualLoraEntries        TemplateSectionManualLoraEntry[]

  @@unique([projectTemplateSectionId, bindingKey])
  @@unique([projectTemplateSectionId, id])
  @@index([projectTemplateSectionId, sortOrder])
  @@index([categoryId])
  @@index([presetId])
  @@index([variantId])
  @@index([presetGroupId])
  @@index([groupBindingKey])
}

model TemplateSectionPromptBlock {
  id                       String                        @id @default(cuid())
  projectTemplateSectionId String
  templateSectionBindingId String?                       @unique
  type                     String                        @default("custom")
  customLabel              String?
  customPositive           String?
  customNegative           String?
  sortOrder                Int                           @default(0)
  createdAt                DateTime                      @default(now())
  updatedAt                DateTime                      @updatedAt
  projectTemplateSection   ProjectTemplateSection        @relation(fields: [projectTemplateSectionId], references: [id], onDelete: Cascade)
  templateSectionBinding   TemplateSectionPresetBinding? @relation(fields: [projectTemplateSectionId, templateSectionBindingId], references: [projectTemplateSectionId, id], onDelete: Cascade)

  @@unique([projectTemplateSectionId, templateSectionBindingId])
  @@index([projectTemplateSectionId, sortOrder])
}

model TemplateSectionManualLoraEntry {
  id                       String                        @id @default(cuid())
  projectTemplateSectionId String
  templateSectionBindingId String?
  stage                    String
  path                     String
  weight                   Float                         @default(1)
  enabled                  Boolean                       @default(true)
  detachedFromBindingKey   String?
  detachedFromPresetId     String?
  detachedFromVariantId    String?
  detachedFromPath         String?
  metadata                 Json?
  sortOrder                Int                           @default(0)
  createdAt                DateTime                      @default(now())
  updatedAt                DateTime                      @updatedAt
  projectTemplateSection   ProjectTemplateSection        @relation(fields: [projectTemplateSectionId], references: [id], onDelete: Cascade)
  templateSectionBinding   TemplateSectionPresetBinding? @relation(fields: [projectTemplateSectionId, templateSectionBindingId], references: [projectTemplateSectionId, id], onDelete: Restrict)

  @@index([projectTemplateSectionId, stage, sortOrder])
  @@index([templateSectionBindingId])
  @@index([detachedFromBindingKey])
}

model ProjectTemplateSectionFolder {
  id                String                         @id @default(cuid())
  projectTemplateId String
  parentId          String?
  name              String
  sortOrder         Int                            @default(0)
  createdAt         DateTime                       @default(now())
  updatedAt         DateTime                       @updatedAt
  projectTemplate   ProjectTemplate                @relation(fields: [projectTemplateId], references: [id], onDelete: Cascade)
  parent            ProjectTemplateSectionFolder?  @relation("ProjectTemplateSectionFolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children          ProjectTemplateSectionFolder[] @relation("ProjectTemplateSectionFolderTree")
  sections          ProjectTemplateSection[]

  @@index([projectTemplateId, parentId, sortOrder])
}

// ── Core models ──

model Project {
  id                    String                 @id @default(cuid())
  title                 String
  slug                  String                 @unique
  status                String                 @default("draft")
  coverImageId          String?
  folderId              String?
  checkpointName        String?
  projectLevelOverrides Json?
  notes                 String?
  publishedAt           DateTime?
  archivedAt            DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  folder                ProjectFolder?         @relation(fields: [folderId], references: [id], onDelete: SetNull)
  sections              ProjectSection[]
  sectionFolders        ProjectSectionFolder[]
  runs                  Run[]
  censoringTasks        CensoringTask[]
  presetBindingRows     ProjectPresetBinding[]

  @@index([status, updatedAt])
  @@index([coverImageId])
  @@index([folderId])
}

model ProjectPresetBinding {
  id         String         @id @default(cuid())
  projectId  String
  categoryId String
  presetId   String
  variantId  String?
  sortOrder  Int            @default(0)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  project    Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  category   PresetCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  preset     Preset         @relation(fields: [categoryId, presetId], references: [categoryId, id], onDelete: Restrict)
  variant    PresetVariant? @relation(fields: [presetId, variantId], references: [presetId, id], onDelete: Restrict)

  @@unique([projectId, categoryId])
  @@index([projectId, sortOrder])
  @@index([categoryId])
  @@index([presetId])
  @@index([variantId])
}

model ProjectFolder {
  id        String          @id @default(cuid())
  parentId  String?
  name      String
  sortOrder Int             @default(0)
  parent    ProjectFolder?  @relation("ProjectFolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  ProjectFolder[] @relation("ProjectFolderTree")
  projects  Project[]

  @@index([parentId, sortOrder])
}

model ProjectSection {
  id                  String                   @id @default(cuid())
  projectId           String
  folderId            String?
  name                String?
  sortOrder           Int                      @default(0)
  enabled             Boolean                  @default(true)
  aspectRatio         String?
  aspectRatios        Json?
  shortSidePx         Int?
  batchSize           Int?
  seedPolicy1         String?
  seedPolicy2         String?
  ksampler1           Json?
  ksampler2           Json?
  upscaleFactor       Float?
  checkpointName      String?
  extraParams         Json?
  latestRunId         String?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  project             Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  folder              ProjectSectionFolder?    @relation(fields: [folderId], references: [id], onDelete: SetNull)
  runs                Run[]
  changeLogs          SectionChangeLog[]
  presetBindingRows   SectionPresetBinding[]
  sectionPromptBlocks SectionPromptBlock[]
  manualLoraEntries   SectionManualLoraEntry[]

  @@index([projectId, sortOrder])
  @@index([folderId])
}

model SectionPresetBinding {
  id                String                   @id @default(cuid())
  projectSectionId  String
  bindingKey        String
  categoryId        String
  presetId          String?
  variantId         String?
  presetGroupId     String?
  groupBindingKey   String?
  sortOrder         Int                      @default(0)
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  projectSection    ProjectSection           @relation(fields: [projectSectionId], references: [id], onDelete: Cascade)
  category          PresetCategory           @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  preset            Preset?                  @relation(fields: [categoryId, presetId], references: [categoryId, id], onDelete: Restrict)
  variant           PresetVariant?           @relation(fields: [presetId, variantId], references: [presetId, id], onDelete: Restrict)
  presetGroup       PresetGroup?             @relation(fields: [presetGroupId], references: [id], onDelete: Restrict)
  promptBlock       SectionPromptBlock?
  manualLoraEntries SectionManualLoraEntry[]

  @@unique([projectSectionId, bindingKey])
  @@unique([projectSectionId, id])
  @@index([projectSectionId, sortOrder])
  @@index([categoryId])
  @@index([presetId])
  @@index([variantId])
  @@index([presetGroupId])
  @@index([groupBindingKey])
}

model SectionPromptBlock {
  id               String                @id @default(cuid())
  projectSectionId String
  sectionBindingId String?               @unique
  type             String                @default("custom")
  customLabel      String?
  customPositive   String?
  customNegative   String?
  sortOrder        Int                   @default(0)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  projectSection   ProjectSection        @relation(fields: [projectSectionId], references: [id], onDelete: Cascade)
  sectionBinding   SectionPresetBinding? @relation(fields: [projectSectionId, sectionBindingId], references: [projectSectionId, id], onDelete: Cascade)

  @@unique([projectSectionId, sectionBindingId])
  @@index([projectSectionId, sortOrder])
}

model SectionManualLoraEntry {
  id                     String                @id @default(cuid())
  projectSectionId       String
  sectionBindingId       String?
  stage                  String
  path                   String
  weight                 Float                 @default(1)
  enabled                Boolean               @default(true)
  detachedFromBindingKey String?
  detachedFromPresetId   String?
  detachedFromVariantId  String?
  detachedFromPath       String?
  metadata               Json?
  sortOrder              Int                   @default(0)
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  projectSection         ProjectSection        @relation(fields: [projectSectionId], references: [id], onDelete: Cascade)
  sectionBinding         SectionPresetBinding? @relation(fields: [projectSectionId, sectionBindingId], references: [projectSectionId, id], onDelete: Restrict)

  @@index([projectSectionId, stage, sortOrder])
  @@index([sectionBindingId])
  @@index([detachedFromBindingKey])
}

model ProjectSectionFolder {
  id        String                 @id @default(cuid())
  projectId String
  parentId  String?
  name      String
  sortOrder Int                    @default(0)
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt
  project   Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent    ProjectSectionFolder?  @relation("ProjectSectionFolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  ProjectSectionFolder[] @relation("ProjectSectionFolderTree")
  sections  ProjectSection[]

  @@index([projectId, parentId, sortOrder])
}

model SectionChangeLog {
  id               String         @id @default(cuid())
  projectSectionId String
  dimension        String // "runParams" | "prompt" | "lora"
  title            String
  before           Json?
  after            Json?
  createdAt        DateTime       @default(now())
  projectSection   ProjectSection @relation(fields: [projectSectionId], references: [id], onDelete: Cascade)

  @@index([projectSectionId, dimension, createdAt])
}

model Run {
  id                     String         @id @default(cuid())
  projectId              String
  projectSectionId       String
  runIndex               Int            @default(1)
  status                 String         @default("queued")
  resolvedConfigSnapshot Json
  comfyPromptId          String?
  executionMeta          Json?
  submittedPrompt        Json? // Full submitted ComfyUI workflow JSON
  outputDir              String?
  comfyOutputSubfolder   String?
  errorMessage           String?
  startedAt              DateTime?
  finishedAt             DateTime?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  project                Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectSection         ProjectSection @relation(fields: [projectSectionId], references: [id], onDelete: Cascade)
  images                 ImageResult[]

  @@index([status, createdAt])
  @@index([projectId, createdAt])
  @@index([projectSectionId, createdAt])
}

model ImageResult {
  id                String          @id @default(cuid())
  runId             String
  filePath          String          @unique
  thumbPath         String?
  width             Int?
  height            Int?
  fileSize          BigInt?
  reviewStatus      String          @default("pending")
  featured          Boolean         @default(false)
  featured2         Boolean         @default(false)
  reviewedAt        DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  run               Run             @relation(fields: [runId], references: [id], onDelete: Cascade)
  trashRecord       TrashRecord?
  censoredFilePath  String?
  censoredThumbPath String?
  censoredAt        DateTime?
  censoringTasks    CensoringTask[]

  @@index([reviewStatus, createdAt])
  @@index([runId, createdAt])
}

model TrashRecord {
  id            String      @id @default(cuid())
  imageResultId String      @unique
  originalPath  String
  trashPath     String
  reason        String?
  deletedAt     DateTime    @default(now())
  restoredAt    DateTime?
  actorType     String      @default("user")
  imageResult   ImageResult @relation(fields: [imageResultId], references: [id], onDelete: Cascade)

  @@index([deletedAt])
  @@index([restoredAt])
}

model CensoringTask {
  id            String      @id @default(cuid())
  projectId     String
  imageResultId String
  status        String      @default("queued")
  errorMessage  String?
  createdAt     DateTime    @default(now())
  startedAt     DateTime?
  finishedAt    DateTime?
  project       Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  imageResult   ImageResult @relation(fields: [imageResultId], references: [id], onDelete: Cascade)

  @@index([projectId, status])
  @@index([status, createdAt])
}

model LoraAsset {
  id           String   @id @default(cuid())
  name         String
  modelType    String   @default("lora")
  category     String
  fileName     String
  absolutePath String   @unique
  relativePath String
  size         BigInt?
  source       String?
  notes        String?
  triggerWords String? // trigger words for this LoRA
  civitaiLink  String?
  uploadedAt   DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  action     String
  payload    Json?
  actorType  String   @default("system")
  createdAt  DateTime @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([action, createdAt])
}

model GpuTaskLock {
  id         String    @id @default(cuid())
  taskType   String
  ownerType  String
  ownerId    String
  status     String    @default("active")
  startedAt  DateTime  @default(now())
  releasedAt DateTime?
  metadata   Json?

  @@index([status, startedAt])
  @@index([ownerType, ownerId])
  @@index([taskType, status])
}
